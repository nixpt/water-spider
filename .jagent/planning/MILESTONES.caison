# the 22 ticket files, tags v0.1.0..v0.6.4 and merged PRs #1-#6. Milestone ids and ticket grouping follow ROADMAP.md;
# M6 is added for WATERS-022 (filed in PR #6, absent from ROADMAP.md).

schema: "milestones/1"

project: {
  name: "water-spider"
  kind: "repo"
