  home: "zorro"
  ticket_prefix: "WATERS"
  root: "f357de863e6f88450a5be8c724beeb91388ba95d"
  summary: "standalone cost-safe RunPod lifecycle CLI (create, tunnel, serve, verified teardown) with GHCR images and an MCP surface; tags v0.1.0..v0.6.4 (VERSION 0.6.4); last commit 2026-08-30; WATERS-003/017/021/022 open"
  north_star: "a standalone, cost-safe RunPod lifecycle CLI that lets a local harness provision, use and reliably tear down GPU pods, with every non-billable behavior under deterministic tests and live-data paths backed by dated evidence"
  stewards: ["arisu", "ann"]
  evidence: {
    default_branch: "main"
  }
}

