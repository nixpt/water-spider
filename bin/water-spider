#!/usr/bin/env bash
# water-spider — a thin RunPod pod-lifecycle helper, built on `runpodctl` +
# the fleet's own images (default: nixpt/zorro).
#
# NAME: the lean-manufacturing "water spider" role — ferries supplies to a
# workstation so the worker never has to leave their post. Here: handles
# provisioning/connect-info/teardown so an agent (or captain) never has to
# hand-run the runpodctl+ssh dance, and — critically — never forgets the
# teardown step that stops the billing clock.
#
# WHY THIS EXISTS: the runpod-ops skill (~/.claude/skills/runpod-ops/) is the
# accumulated protocol from two real validation campaigns (s343, s364) plus
# POD-0811's post-mortem — a lot of it documents MANUAL workarounds for an
# OLDER runpodctl that lacked structured output and a real pod-lifecycle
# surface. This tool assumes the CURRENT runpodctl (verified this session:
# `pod create/list/get/delete`, `ssh info`, `send`/`receive` via croc, all
# with `-o json`), and automates what used to be manual. It does NOT
# reimplement the RunPod API — every subcommand is a runpodctl wrapper.
#
# HONESTY NOTE (read before trusting a subcommand blind): `create`/`list`/
# `status`/`get`/`teardown` are tested against a real (empty) account this
# session — auth works, JSON parses, the empty-list case is exercised.
# `connect`/`send`/`receive` are NOT live-tested against a real running pod
# (that costs money to spin up) — they're built correctly against
# runpodctl's documented interface, but treat them as first-use-verify,
# not proven, until someone runs them against a real pod.
#
# Usage:
#   water-spider create [--template-id ID] [--image IMG] [--name NAME]
#                        [--gpu "GPU NAME"] [--gpu-count N] [--ports SPEC]
#                        [--disk GB] [--volume GB] [--cloud SECURE|COMMUNITY]
#                        [--restore FILE]    # replay a saved snapshot after boot
#                        [--idempotency-key KEY]  # retry-safe: same key replays
#                        #  the same pod instead of creating a second one
#                        #  (pattern ported from checkstand-core's checkout())
#                        [--min-download MBPS] [--min-upload MBPS]
#                        [--cuda-versions "12.4,12.5"] [--data-center ID] [--country CC]
#                        [--registry-auth-id ID]  # RunPod containerRegistryAuthId —
#                        #  required to pull a PRIVATE image (defaults from
#                        #  $WATER_SPIDER_REGISTRY_AUTH_ID so you don't need
#                        #  to pass it every time for a private image family)
#                        #  GraphQL-only fields runpodctl's CLI doesn't expose —
#                        #  given any of these, create switches to a direct
#                        #  GraphQL call instead of runpodctl (same downstream
#                        #  id/verify/idempotency logic either way)
#   water-spider list
#   water-spider status                    # balance + spend/hr + pod count
#   water-spider get <pod-id>
#   water-spider connect <pod-id>          # resolve + print ssh + proxy fallback
#   water-spider send <local-path>         # you -> pod (prints the paired cmd)
#   water-spider receive <pod-id> <remote-path> [local-dest]
#   water-spider tunnel <pod-id> [--port LOCAL:REMOTE ...] [--stop]
#                        # default ports: 8080 (zorro serve), 11450 (pf serve)
#   water-spider recipe list
#   water-spider recipe serve <pod-id> <model-path> [--engine zorro|llama|llama-agent|pf]
#                        [--port N]        # launch + auto-tunnel + print local URL
#   water-spider gui <pod-id> [--x11|--trusted] [--display N] [--] <command...>
#                        # a GUI app launched on the pod renders as a window
#                        # on YOUR local machine. Prefers xpra (ssh transport,
#                        # survives a dropped connection) if installed locally;
#                        # falls back to raw X11 forwarding (--x11 forces it)
#   water-spider snapshot <pod-id> [-o FILE]   # save model list + image provenance
#   water-spider teardown <pod-id> [--session-name NAME] [--pull PATH...]
#   water-spider gpus [--available]        # `runpodctl gpu list`, filtered
#   water-spider ps  <pod-id> [--host H --pod-port P] [--limit N]
#   water-spider gpu <pod-id> [--host H --pod-port P] [--watch N]
#                        # READ-ONLY pod visibility over ONE ssh round trip per
#                        # refresh (ControlMaster reuse, secrets redacted, risk
#                        # flags). Explicit --host/--pod-port needs no RunPod API.
#   water-spider top <pod-id> [--host H --pod-port P] [--interval N] [--once]
#                        [--limit N] [--t0-balance USD]
#                        # one-screen dashboard: CPU, net rx/tx, spend, top procs (N >= 5)
#   water-spider logs <pod-id> [<path>|--sync] [--follow] [--lines N]
#                        [--host H --pod-port P]
#                        # read-only tail of ONE file under /workspace, /var/log or
#                        # /tmp (--sync = /workspace/sync.txt); credential-looking
#                        # paths refused; --follow is one long ssh, no polling
#   water-spider watch <pod-id> --json [--interval N] [--out FILE]
#                        [--host H --pod-port P]
#                        # one JSON line per tick (N >= 5). --json is REQUIRED:
#                        # `watch` without it is an error (no text mode yet)
#   water-spider scaffold <name> [foreman-scaffold flags...]
#                        # OPTIONAL, fleet-internal only: thin passthrough to
#                        # foreman-scaffold (needs a sibling jokersquad
#                        # checkout — not available outside the nixpt fleet
#                        # layout). Everything else above works standalone.
#
# Env:
#   WATER_SPIDER_TEMPLATE_ID   default --template-id for `create`
#   WATER_SPIDER_IMAGE         default --image for `create` (used only if
#                               WATER_SPIDER_TEMPLATE_ID is unset)
#   WATER_SPIDER_SSH_KEY       -i path for the printed ssh command (default:
#                               ~/.ssh/runpod, matching runpod-ops convention)
#
# runpodctl auth: this tool assumes `runpodctl doctor` has already been run
# (persists the API key to ~/.runpod/config.toml) — same assumption the rest
# of the fleet's runpod tooling makes. If you need to scope the key
# per-invocation instead, wrap the whole call:
#   secure-env run --env RUNPOD_API_KEY -- water-spider <args...>
#
# WHAT THIS TOOL DELIBERATELY DOES NOT DO: a byte-for-byte filesystem
# snapshot/restore of a whole pod. The documented pod→home transport is slow
# (~0.26 MB/s over the ssh pipe, runpod-ops §7) — genuinely fine for small
# artifacts, genuinely not for a whole disk. `snapshot`/`--restore` here
# capture and replay a lightweight MANIFEST (which models are pulled, from
# which HF repos, plus the image provenance stamp to catch a mismatched
# restore) — re-provisioning by re-running fast xet downloads on the new pod
# is both cheaper and more honest than trying to pull the bytes down and
# back up again. If a real full-disk snapshot is ever wanted, that's RunPod's
# own network-volume reattachment story, not a job for this tool.
#
# Web terminal / Jupyter: untouched by this tool or the image, on purpose —
# both are the RunPod base's own services (its `/start.sh` starts Jupyter
# when `$JUPYTER_PASSWORD` is set; the web terminal is the RunPod console's
# own feature, nothing this tool or the pod image does affects it either
# way). Nothing here should ever need to.
set -euo pipefail

SCRIPT_NAME="water-spider"
SSH_KEY="${WATER_SPIDER_SSH_KEY:-$HOME/.ssh/runpod}"

die() { echo "$SCRIPT_NAME: $*" >&2; exit 1; }

# `bucket-bridge` (squadron/jokersquad's fleet-safe wrapper over `buckets` —
# see /workspace/projects/buckets/README.md) can JIT-provision a missing tool
# into PATH for the rest of this process, rather than hard-failing. Only
# tried for tools buckets' dist server actually carries (jq: confirmed —
# `buckets info jq` resolves); NOT a substitute for runpodctl/ssh/pgrep,
# which are platform/system tools outside buckets' language-runtime scope.
need_or_bucket() {
  local tool="$1"
  command -v "$tool" >/dev/null 2>&1 && return 0
  local bb="/workspace/projects/jokersquad/bin/bucket-bridge"
  if [ -x "$bb" ]; then
    echo "$SCRIPT_NAME: $tool missing, trying bucket-bridge..." >&2
    local env_out
    if env_out="$("$bb" env "${tool}@latest" 2>/dev/null)"; then
      eval "$env_out"
      command -v "$tool" >/dev/null 2>&1 && { echo "$SCRIPT_NAME: $tool provisioned via buckets" >&2; return 0; }
    fi
  fi
  return 1
}
need() { need_or_bucket "$1" || die "missing dependency: $1 (and bucket-bridge couldn't provision it — install manually)"; }
need runpodctl
need jq
need ssh
need pgrep

usage() {
  sed -n '/^# Usage:/,/^set -euo/p' "$0" | sed '1d;$d;s/^# \{0,1\}//'
}

# runpodctl prints a usage block mixed in with its own JSON error blob on
# some API-level failures (not just CLI-parse errors) — observed on a plain
# 404 from `pod get`. Capture combined output, try to surface just the
# error's message on failure instead of dumping the raw mixed noise.
rp_json() {
  local out rc=0
  # `|| rc=$?`, not `; rc=$?` — under `set -e`, a bare failing assignment
  # exits the shell immediately, before the next statement ever runs. This
  # bit the FIRST version of this function (silently swallowed every error,
  # no message, just a bare exit 1) — verified live before shipping.
  out="$(runpodctl "$@" -o json 2>&1)" || rc=$?
  if [ $rc -ne 0 ]; then
    # runpodctl prints its error TWICE on some failures — a properly-escaped
    # JSON line to stdout, then a usage block, then a second MALFORMED
    # (unescaped-quote) JSON blob to stderr. Take the first line that
    # actually parses as JSON via jq (correctly handles the escaping a
    # regex extraction got wrong on nested error messages — verified live).
    local msg
    msg="$(echo "$out" | grep -m1 '^{' | jq -r '.error // empty' 2>/dev/null)"
    die "runpodctl ${*} failed${msg:+: $msg}"
  fi
  echo "$out"
}

# ---- create ------------------------------------------------------------
# ---- idempotency (ported from checkstand-core's checkout() pattern) -------
# Real payment gateways (Stripe) and checkstand's own MCP adapter use a
# caller-supplied idempotency key so a RETRIED call returns the SAME result
# instead of re-executing — the exact shape of the flaky-create problem
# runpod-ops already documents (an agent can't always tell if a `pod create`
# actually landed before a timeout/retry, and a naive retry creates a second
# BILLED pod). This is a better fix than the "check pod list before/after,
# never retry" discipline the rest of this function still also does as a
# second line of defense: a client-side ledger keyed by the idempotency key,
# checked BEFORE calling runpodctl, with an mkdir-based lock (atomic on
# POSIX filesystems) covering the genuinely-concurrent-same-key race —
# checkstand's own two-phase check (cheap pre-check, re-check under the
# write lock) ported to a bash+filesystem equivalent since there's no
# in-process lock to hold across a bash script invocation.
IDEMPOTENCY_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/water-spider/idempotency"

# ---- GraphQL escape hatch (runpod-python recon) ---------------------------
# `runpodctl`'s CLI wraps RunPod's REST layer, which does NOT expose two
# fields the GraphQL API does: `minDownload`/`minUpload` (bandwidth FLOOR at
# creation time) and `allowedCudaVersions`. Both map directly onto real,
# already-documented failure classes: POD-0811 was a pod with dead bulk
# egress discovered 45 minutes and $0.74 into a session (runpod-ops
# post-mortem) — a bandwidth floor filters that class out BEFORE paying for
# it. The driver/toolkit PTX version mismatch (runpod-ops "Variations":
# committed PTX built with a newer CUDA than the pod driver fails at load)
# is exactly what allowedCudaVersions constrains at the scheduling level
# instead of discovering after boot. Confirmed these fields are GraphQL-only
# by reading runpod-python's own mutation builder
# (runpod/api/mutations/pods.py) — not exposed via REST, hence not via
# runpodctl. Endpoint/mutation shape verified against runpod-python's
# graphql.py + mutations/pods.py; API key read from runpodctl's OWN config
# (~/.runpod/config.toml) so this doesn't need separate auth setup.
ws_api_key() {
  [ -n "${RUNPOD_API_KEY:-}" ] && { echo "$RUNPOD_API_KEY"; return; }
  local cfg="$HOME/.runpod/config.toml"
  [ -f "$cfg" ] || die "no RUNPOD_API_KEY and no $cfg — run 'runpodctl config' or export RUNPOD_API_KEY"
  grep -oP "(?<=apikey = ')[^']+" "$cfg" 2>/dev/null || grep -oP '(?<=apikey = ")[^"]+' "$cfg"
}

# ---- pod reads/terminate via GraphQL (WATERS-024) ---------------------------
# runpodctl <=2.x REST calls (`pod list|get|delete|create`) go to
# rest.runpod.io, which no longer resolves (REST moved to api.runpod.io/v2;
# runpodctl >=3.1.1 follows it, 2.1.9 does not). GraphQL on api.runpod.io is
# stable and is what `runpodctl user|gpu list|ssh info` already use, so pod
# reads and terminate go straight to GraphQL here. Chosen over falling back to
# `runpodctl pod list` because that fallback would depend on whichever
# runpodctl happens to be installed. Every helper RETURNS non-zero (never
# "empty success") on transport, HTTP-level, or GraphQL errors so callers can
# fail closed.
ws_gql() {
  local query="$1" key resp
  key="$(ws_api_key)" || return 1
  # The key goes in via a curl config on stdin (-K -), never on argv, so it
  # is not visible in ps or /proc/*/cmdline.
  resp="$(printf 'header = "Authorization: Bearer %s"\n' "$key" | curl -sS --max-time 30 -K - -X POST "https://api.runpod.io/graphql" \
    -H "Content-Type: application/json" \
    -d "$(jq -n --arg q "$query" '{query: $q}')")" \
    || { echo "GraphQL request failed (network?)" >&2; return 1; }
  if ! printf '%s' "$resp" | jq -e 'type=="object"' >/dev/null 2>&1; then
    echo "GraphQL returned a non-JSON response" >&2; return 1
  fi
  if printf '%s' "$resp" | jq -e '.errors' >/dev/null 2>&1; then
    echo "GraphQL error: $(printf '%s' "$resp" | jq -r '.errors[0].message // .errors' 2>/dev/null)" >&2; return 1
  fi
  printf '%s' "$resp"
}

# Emits a JSON array of pods (same field names the jq filters expect:
# id, name, desiredStatus, costPerHr, machine.gpuDisplayName). `[]` means the
# query SUCCEEDED and the account has no pods; any failure returns non-zero.
ws_pods_json() {
  local resp
  resp="$(ws_gql '{ myself { pods { id name desiredStatus costPerHr gpuCount imageName machine { gpuDisplayName podHostId } } } }')" || return 1
  printf '%s' "$resp" | jq -e '.data.myself.pods | if type=="array" then . else error("no pod list") end' 2>/dev/null \
    || { echo "GraphQL pod listing had no .data.myself.pods array" >&2; return 1; }
}

ws_pod_json() {
  local id="$1" resp
  [[ "$id" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "invalid pod id: $id" >&2; return 1; }
  resp="$(ws_gql "{ pod(input: {podId: \"$id\"}) { id name desiredStatus costPerHr gpuCount imageName vcpuCount memoryInGb containerDiskInGb volumeInGb machine { gpuDisplayName podHostId } runtime { uptimeInSeconds ports { ip isIpPublic privatePort publicPort type } } } }")" || return 1
  printf '%s' "$resp" | jq -e '.data.pod | select(. != null)' 2>/dev/null || { echo "pod $id not found" >&2; return 1; }
}

# podTerminate returns Void; success of the REQUEST says nothing about the pod
# being gone — teardown always re-queries ws_pods_json afterwards.
ws_pod_terminate() {
  local id="$1"
  [[ "$id" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "invalid pod id: $id" >&2; return 1; }
  ws_gql "mutation { podTerminate(input: {podId: \"$id\"}) }" >/dev/null
}

# runpodctl < 3.1.1 sends `pod create|list|get|delete` to the dead
# rest.runpod.io. Only the default (non-GraphQL) create still uses `pod create`,
# so gate it: refuse with a clear message (no pod is created) instead of
# failing mid-way with a DNS error.
ws_require_rest_capable_runpodctl() {
  local v
  v="$(runpodctl version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)" || true
  [ -n "$v" ] || die "create: could not read 'runpodctl version' — refusing (need >= 3.1.1 for 'pod create')"
  if [ "$(printf '%s\n3.1.1\n' "$v" | sort -V | head -1)" != "3.1.1" ]; then
    die "create: runpodctl $v talks to the retired rest.runpod.io; 'pod create' needs runpodctl >= 3.1.1 (upgrade it), or pass a GraphQL-path flag (--country/--data-center/--cuda-versions/--min-download/--min-upload/--registry-auth-id). Nothing was created."
  fi
}

ws_gql_string() {
  jq -Rnr --arg value "$1" '$value | @json'
}

ws_require_uint() {
  local flag="$1" value="$2"
  [[ "$value" =~ ^[0-9]+$ ]] || die "create: $flag must be a non-negative integer (got '$value')"
}

ws_require_number() {
  local flag="$1" value="$2"
  [[ "$value" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "create: $flag must be a non-negative number (got '$value')"
}

# GPU-pod create via GraphQL — only reached when a GraphQL-only flag is
# given (min_download/min_upload/cuda_versions/data_center/country); the
# default `create` path stays on runpodctl, already tested and unchanged.
ws_create_via_graphql() {
  local name="$1" image="$2" template_id="$3" gpu="$4" gpu_count="$5" \
        disk="$6" volume="$7" cloud="$8" ports="$9"
  shift 9
  local min_dl="$1" min_ul="$2" cuda_versions="$3" dc="$4" country="$5" registry_auth_id="$6"

  need curl
  local fields=("name: $(ws_gql_string "$name")" "cloudType: $cloud" "startSsh: true"
    "gpuTypeId: $(ws_gql_string "$gpu")" "supportPublicIp: true" "gpuCount: $gpu_count"
    "volumeInGb: $volume" "containerDiskInGb: $disk" "ports: $(ws_gql_string "$ports")"
    "volumeMountPath: \"/workspace\"")
  [ -n "$image" ] && fields+=("imageName: $(ws_gql_string "$image")")
  [ -n "$template_id" ] && fields+=("templateId: $(ws_gql_string "$template_id")")
  [ -n "$min_dl" ] && fields+=("minDownload: $min_dl")
  [ -n "$min_ul" ] && fields+=("minUpload: $min_ul")
  if [ -n "$cuda_versions" ]; then
    local cv_list="" cv encoded
    while IFS= read -r cv; do
      encoded="$(ws_gql_string "$cv")"
      cv_list="${cv_list:+$cv_list,}$encoded"
    done < <(printf '%s\n' "$cuda_versions" | tr ',' '\n')
    fields+=("allowedCudaVersions: [$cv_list]")
  fi
  [ -n "$dc" ] && fields+=("dataCenterId: $(ws_gql_string "$dc")")
  [ -n "$country" ] && fields+=("countryCode: $(ws_gql_string "$country")")
  # containerRegistryAuthId: needed the moment `--image`/imageName points at
  # a PRIVATE registry repo — RunPod can't pull it anonymously otherwise.
  # runpodctl's CLI/REST `pod create` has NO flag for this at all (checked:
  # `runpodctl create pod --help`) — same class of gap as minDownload/
  # allowedCudaVersions above, hence routed through this same GraphQL path
  # rather than a runpodctl flag that doesn't exist.
  [ -n "$registry_auth_id" ] && fields+=("containerRegistryAuthId: $(ws_gql_string "$registry_auth_id")")

  local joined; joined="$(printf '%s\n' "${fields[@]}" | paste -sd, -)"
  local query="mutation { podFindAndDeployOnDemand(input: { $joined }) { id imageName machineId machine { podHostId } } }"
  local key; key="$(ws_api_key)"
  local resp
  resp="$(printf 'header = "Authorization: Bearer %s"\n' "$key" | curl -sS -K - -X POST "https://api.runpod.io/graphql" \
    -H "Content-Type: application/json" \
    -d "$(jq -n --arg q "$query" '{query: $q}')")" || die "GraphQL request failed (network?)"
  if echo "$resp" | jq -e '.errors' >/dev/null 2>&1; then
    die "GraphQL create failed: $(echo "$resp" | jq -r '.errors[0].message // .errors' 2>/dev/null)"
  fi
  echo "$resp" | jq '{id: .data.podFindAndDeployOnDemand.id}'
}

cmd_create() {
  local template_id="${WATER_SPIDER_TEMPLATE_ID:-}"
  local image="${WATER_SPIDER_IMAGE:-}"
  local name="" gpu="" gpu_count=1 ports="22/tcp" disk=60 volume=200 cloud="SECURE" restore="" idem_key=""
  local min_dl="" min_ul="" cuda_versions="" dc="" country=""
  # Default from WATER_SPIDER_REGISTRY_AUTH_ID so `nixpt/zorro`-family
  # private-image pulls just work without remembering the flag every time —
  # explicit --registry-auth-id (including "" to force-disable) still wins.
  local registry_auth_id="${WATER_SPIDER_REGISTRY_AUTH_ID:-}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --template-id) template_id="$2"; shift 2 ;;
      --image) image="$2"; shift 2 ;;
      --name) name="$2"; shift 2 ;;
      --gpu) gpu="$2"; shift 2 ;;
      --gpu-count) gpu_count="$2"; shift 2 ;;
      --ports) ports="$2"; shift 2 ;;
      --disk) disk="$2"; shift 2 ;;
      --volume) volume="$2"; shift 2 ;;
      --cloud) cloud="$2"; shift 2 ;;
      --restore) restore="$2"; shift 2 ;;
      --idempotency-key) idem_key="$2"; shift 2 ;;
      # GraphQL-only fields (runpodctl's CLI/REST doesn't expose these —
      # see ws_create_via_graphql's header note for why they matter):
      --min-download) min_dl="$2"; shift 2 ;;    # Mbps floor — filters the
      --min-upload) min_ul="$2"; shift 2 ;;      # POD-0811 dead-egress class
      --cuda-versions) cuda_versions="$2"; shift 2 ;;  # e.g. "12.4,12.5" —
                        # filters the driver/toolkit PTX mismatch class
      --data-center) dc="$2"; shift 2 ;;
      --country) country="$2"; shift 2 ;;
      --registry-auth-id) registry_auth_id="$2"; shift 2 ;;  # RunPod
                        # containerRegistryAuthId — required to pull a
                        # PRIVATE image (e.g. nixpt/zorro since 2026-08-16).
                        # Defaults from $WATER_SPIDER_REGISTRY_AUTH_ID.
      *) die "create: unknown flag '$1'" ;;
    esac
  done
  # NOTE on ports: --ports only affects what RunPod's own proxy/console
  # exposes. `water-spider tunnel` uses SSH -L (forwarding INSIDE the ssh
  # session), which only needs port 22 — you do NOT need to declare 8080/
  # 11450 here just to use tunnel/recipe. Add them only if you want RunPod's
  # own console/proxy to serve them directly instead.
  [ -z "$restore" ] || [ -f "$restore" ] || die "create: --restore file not found: $restore"
  [ -n "$template_id" ] || [ -n "$image" ] || die \
    "create: need --template-id or --image (or set WATER_SPIDER_TEMPLATE_ID/WATER_SPIDER_IMAGE). No zorro v3 template exists yet at authoring time — run docker/runpod/create-template.sh first, or pass --image nixpt/zorro:<tag> directly."
  [ -n "$gpu" ] || die "create: --gpu required (see: water-spider gpus --available)"
  case "$cloud" in SECURE|COMMUNITY) ;; *) die "create: --cloud must be SECURE or COMMUNITY (got '$cloud')" ;; esac
  ws_require_uint --gpu-count "$gpu_count"
  ws_require_uint --disk "$disk"
  ws_require_uint --volume "$volume"
  [ -z "$min_dl" ] || ws_require_number --min-download "$min_dl"
  [ -z "$min_ul" ] || ws_require_number --min-upload "$min_ul"
  if [ -n "$cuda_versions" ]; then
    local cv
    while IFS= read -r cv; do
      [[ "$cv" =~ ^[0-9]+[.][0-9]+([.][0-9]+)?$ ]] || die "create: --cuda-versions contains invalid version '$cv'"
    done < <(printf '%s\n' "$cuda_versions" | tr ',' '\n')
  fi
  [ -z "$country" ] || [[ "$country" =~ ^[A-Z]{2}$ ]] || die "create: --country must be a two-letter uppercase country code (got '$country')"
  name="${name:-water-spider-$(date +%Y%m%d-%H%M%S)}"

  local ledger="" lockdir=""
  if [ -n "$idem_key" ]; then
    mkdir -p "$IDEMPOTENCY_DIR"
    # Sanitize: a key is caller-supplied, don't let it escape the dir.
    local safe_key; safe_key="$(echo "$idem_key" | tr -c 'A-Za-z0-9_.-' '_')"
    ledger="$IDEMPOTENCY_DIR/$safe_key.json"
    lockdir="$IDEMPOTENCY_DIR/$safe_key.lock"

    # Phase 1 (cheap pre-check, matches checkstand's "common case, no charge
    # attempted at all"): a prior successful create already exists.
    if [ -f "$ledger" ]; then
      local prior_id; prior_id="$(jq -r '.pod_id // empty' "$ledger" 2>/dev/null)"
      if [ -n "$prior_id" ]; then
        # Fail closed: if the listing errors we cannot tell a replay from a
        # fresh create, and guessing "fresh" could bill a duplicate pod.
        local pods_now; pods_now="$(ws_pods_json)" || die "create: cannot list pods to check the idempotency ledger — refusing to create (a blind create could duplicate $prior_id). Fix the API error above, then retry"
        if printf '%s' "$pods_now" | jq -e --arg id "$prior_id" '.[] | select(.id==$id)' >/dev/null 2>&1; then
          echo "==> idempotent replay: key '$idem_key' already created $prior_id — returning it, NOT creating a new pod"
          printf '%s' "$pods_now" | jq -r --arg id "$prior_id" '.[] | select(.id==$id) | "  \(.id)  \(.name)  status=\(.desiredStatus // "-")"'
          return
        fi
      fi
      echo "==> ledger has a stale entry for key '$idem_key' (pod no longer listed) — proceeding as a fresh create"
    fi

    # Phase 2 (the race case): acquire the lock. mkdir is atomic — the
    # loser sees a real failure, not a corrupted partial state.
    local tries=0
    until mkdir "$lockdir" 2>/dev/null; do
      tries=$((tries + 1))
      [ "$tries" -lt 30 ] || die "create: could not acquire idempotency lock for key '$idem_key' after 30s — another 'create' with the same key may be stuck; check/remove $lockdir by hand if you're sure nothing else is running"
      sleep 1
    done
    # Intentional early expansion: lockdir is fixed when the trap is set.
    # shellcheck disable=SC2064
    trap "rmdir '$lockdir' 2>/dev/null || true" EXIT
    # Re-check under the lock (the genuinely-concurrent case: another
    # process won the race and already committed while we waited).
    if [ -f "$ledger" ]; then
      local prior_id2; prior_id2="$(jq -r '.pod_id // empty' "$ledger" 2>/dev/null)"
      if [ -n "$prior_id2" ]; then
        local pods_now2; pods_now2="$(ws_pods_json)" || die "create: cannot list pods to re-check the idempotency ledger under the lock — refusing to create"
        if printf '%s' "$pods_now2" | jq -e --arg id "$prior_id2" '.[] | select(.id==$id)' >/dev/null 2>&1; then
          echo "==> idempotent replay (post-lock): another call already created $prior_id2 for key '$idem_key'"
          return
        fi
      fi
    fi
  fi

  # The flaky-create trap (runpod-ops §Variations): older runpodctl truncated
  # its own success JSON and looked like a failure, and a blind retry loop
  # created 3 billed dupes (s343). Modern runpodctl gives real structured
  # output — trust ONE attempt, verify by `pod list` after, NEVER auto-retry.
  # (With --idempotency-key above, a genuine retry is now SAFE too — but the
  # underlying single-attempt discipline stays, since the key only protects
  # against re-EXECUTING, not against a create call that's ambiguous by itself.)
  echo "==> pods before create:"
  # Fail closed: an unreadable listing is NOT "no pods" — refuse to create.
  local pods_before
  pods_before="$(ws_pods_json)" || die "create: cannot list existing pods — refusing to create (cannot rule out a duplicate). Fix the API error above; do NOT blindly retry"
  printf '%s' "$pods_before" | jq -r '.[] | "  \(.id)  \(.name // "-")  \(.desiredStatus // "-")"'
  [ "$(printf '%s' "$pods_before" | jq 'length')" != "0" ] || echo "  (none)"

  local out
  if [ -n "$min_dl" ] || [ -n "$min_ul" ] || [ -n "$cuda_versions" ] || [ -n "$dc" ] || [ -n "$country" ] || [ -n "$registry_auth_id" ]; then
    echo "==> creating via GraphQL (min-download=$min_dl min-upload=$min_ul cuda-versions=$cuda_versions" \
         "data-center=$dc country=$country registry-auth-id=$registry_auth_id) — runpodctl's CLI doesn't expose these fields"
    if [ -z "$registry_auth_id" ] || [ -n "$min_dl$min_ul$cuda_versions$dc$country" ]; then
      echo "    min-download/min-upload/cuda-versions/data-center/country: NOT live-tested this" \
           "session (would create a real billed pod to verify) — endpoint/mutation shape" \
           "verified against runpod-python's own source only"
    fi
    out="$(ws_create_via_graphql "$name" "$image" "$template_id" "$gpu" "$gpu_count" \
      "$disk" "$volume" "$cloud" "$ports" "$min_dl" "$min_ul" "$cuda_versions" "$dc" "$country" "$registry_auth_id")" \
      || die "GraphQL create failed — check output above, do NOT blindly retry"
  else
    ws_require_rest_capable_runpodctl
    local args=(pod create --name "$name" --gpu-id "$gpu" --gpu-count "$gpu_count" \
      --ports "$ports" --container-disk-in-gb "$disk" --volume-in-gb "$volume" \
      --cloud-type "$cloud")
    if [ -n "$template_id" ]; then args+=(--template-id "$template_id"); else args+=(--image "$image"); fi

    echo "==> creating: runpodctl ${args[*]}"
    out="$(runpodctl "${args[@]}" -o json)" || die "create failed — check output above, do NOT blindly retry (see the flaky-create trap in the header comment)"
  fi
  local id
  id="$(echo "$out" | jq -r '.id // empty')"
  [ -n "$id" ] || die "create: no pod id in output — inspect manually before retrying:
$out"
  echo "==> created pod $id ($name)"
  if [ -n "$ledger" ]; then
    jq -n --arg id "$id" --arg key "$idem_key" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '{pod_id: $id, idempotency_key: $key, created_at: $ts}' > "$ledger"
    echo "==> idempotency ledger written: $ledger (a retry with --idempotency-key '$idem_key' will now replay $id, never create a second pod)"
  fi
  echo "==> VERIFYING exactly one new pod exists (not a retry-duplicate):"
  local pods_after
  if pods_after="$(ws_pods_json)"; then
    printf '%s' "$pods_after" | jq -r --arg id "$id" '.[] | select(.id==$id) | "  \(.id)  \(.name)  status=\(.desiredStatus // "-")"'
    printf '%s' "$pods_after" | jq -e --arg id "$id" 'any(.[]; .id==$id)' >/dev/null || echo "⚠️  $id not in the listing yet — check 'water-spider list' before doing anything else (do NOT re-run create)"
  else
    echo "⚠️  could not verify the new pod: the post-create listing failed. $id was created and is BILLING — check 'water-spider list'; do NOT re-run create"
  fi
  if [ -n "$restore" ]; then
    echo "==> --restore checklist (HONEST: this is a checklist, not full automation —"
    echo "    the snapshot only records filenames, not source HF repos, so re-pulling"
    echo "    is a manual step until that gap is closed):"
    jq -r '.model_files[]? // empty' "$restore" 2>/dev/null | sed 's/^/    - /' || echo "    (couldn't parse $restore as a water-spider snapshot)"
    echo "    image this snapshot was taken from: $(jq -r '.image_provenance.base // .image_provenance.zorro_commit // "unknown"' "$restore" 2>/dev/null)"
  fi
  echo "==> next: water-spider connect $id   (pod needs a minute to boot before SSH answers)"
}

# ---- list / status / get ------------------------------------------------
cmd_list() {
  local rows
  local pods
  pods="$(ws_pods_json)" || die "could not list pods (see error above)"
  rows="$(printf '%s' "$pods" | jq -r '
    (["ID","NAME","GPU","STATUS","COST/HR"] | @tsv),
    (.[] | [.id, (.name // "-"), (.machine.gpuDisplayName // .gpuTypeId // "-"),
            (.desiredStatus // .status // "-"), (.costPerHr // "-" | tostring)] | @tsv)
  ')" || die "could not format the pod listing"
  echo "$rows" | column -t -s $'\t'
}

cmd_status() {
  echo "== account =="
  runpodctl user -o json | jq -r '"  balance: $\(.clientBalance | tostring)   spend/hr NOW: $\(.currentSpendPerHr)   spend limit: $\(.spendLimit)"'
  echo "== pods =="
  local n
  n="$(ws_pods_json | jq 'length')" || die "could not list pods (see error above)"
  if [ "$n" = "0" ]; then
    echo "  none — nothing billing right now."
  else
    cmd_list
    echo "  ⚠️  $n pod(s) active — every one bills until 'water-spider teardown'."
  fi
}

cmd_get() {
  local id="${1:?usage: water-spider get <pod-id>}"
  local pod; pod="$(ws_pod_json "$id")" || die "get $id failed (see above)"
  printf '%s\n' "$pod" | jq .
}

# ---- connect -------------------------------------------------------------
# `runpodctl ssh info`'s own --help says "show ssh info (command + key)" —
# that phrasing suggests a ready-made command STRING, not necessarily
# separate host/port JSON fields. NOT verified against a real pod's output
# this session (no billed pod to check against). ws_resolve_host_port tries
# several plausible shapes and REFUSES cleanly (never silently ssh's to an
# empty host) if none match — always prefer --host/--port overrides on
# tunnel/recipe if this guesses wrong on first real use, and fix the parse
# here once the real shape is known.
ws_resolve_host_port() {
  local info="$1" host="" port=""
  host="$(echo "$info" | jq -r '.host // .ip // .publicIp // empty' 2>/dev/null || true)"
  port="$(echo "$info" | jq -r '.port // .sshPort // .publicPort // empty' 2>/dev/null || true)"
  if [ -z "$host" ] || [ -z "$port" ]; then
    # Fall back to parsing a ready-made command string, e.g.
    # "ssh root@1.2.3.4 -p 12345 -i ~/.ssh/id_..." in either arg order.
    local cmd
    cmd="$(echo "$info" | jq -r '.command // empty' 2>/dev/null || true)"
    if [ -n "$cmd" ]; then
      host="$(echo "$cmd" | grep -oP '(?<=@)[0-9A-Za-z_.-]+' | head -1 || true)"
      port="$(echo "$cmd" | grep -oP '(?<=-p )[0-9]+' | head -1 || true)"
    fi
  fi
  echo "${host}:${port}"
}

cmd_connect() {
  local id="${1:?usage: water-spider connect <pod-id>}"
  local info
  info="$(rp_json ssh info "$id")"   # rp_json already dies with a clean message on failure
  echo "$info" | jq . 2>/dev/null || echo "$info"
  local hp host port
  hp="$(ws_resolve_host_port "$info")"; host="${hp%%:*}"; port="${hp##*:}"
  echo
  if [ -n "$host" ] && [ -n "$port" ]; then
    echo "==> direct:  ssh -p $port -i $SSH_KEY root@$host"
  else
    echo "==> could not parse host:port from the JSON above (unverified shape —"
    echo "    see ws_resolve_host_port's header note). Read it by eye and pass"
    echo "    --host/--port explicitly to tunnel/recipe until this is fixed."
  fi
  echo "==> proxy fallback (PTY-only — needs -tt, rejects rsync/scp/binary pipes;"
  echo "    base64-over-tty is the transport workaround, see memory:"
  echo "    feedback_runpod_proxy_pty_transport): ssh -tt <podid>-<hash>@ssh.runpod.io"
  echo "==> POD-0811 lesson: if direct SSH refuses while the API says RUNNING,"
  echo "    try the proxy FIRST — it answers even when sshd on the pod isn't up"
  echo "    yet, which tells you 'pod is fine, sshd isn't' vs 'pod never scheduled'."
  echo "    (zorro's v3 image self-heals this automatically via post_start.sh —"
  echo "    give it ~10-15s after first boot before concluding SSH is broken.)"
}

# ---- send / receive (runpodctl's croc-based transport) -------------------
cmd_send() {
  local path="${1:?usage: water-spider send <local-path>}"
  echo "==> on THIS machine:"
  echo "    runpodctl send $path"
  echo "    (prints a one-time code — e.g. '8338-galileo-tango-alpha')"
  echo "==> then ON THE POD (via ssh):"
  echo "    runpodctl receive <the-code-above>"
  echo "==> NOT live-tested this session (no billed pod to test against) —"
  echo "    croc's relay is a different data plane than the proxy ssh's PTY"
  echo "    limit, so it SHOULD sidestep the documented rsync/scp failures"
  echo "    (feedback_runpod_proxy_pty_transport) — verify on first real use."
}

cmd_receive() {
  local id="${1:?usage: water-spider receive <pod-id> <remote-path> [local-dest]}"
  local remote="${2:?usage: water-spider receive <pod-id> <remote-path> [local-dest]}"
  local dest="${3:-.}"
  echo "==> ON THE POD (via ssh -p <port> -i $SSH_KEY root@<host>, see: water-spider connect $id):"
  echo "    runpodctl send $remote"
  echo "==> then on THIS machine:"
  echo "    (cd $dest && runpodctl receive <the-code-from-the-pod>)"
  echo "==> NOT live-tested this session — same caveat as 'send'."
}

# ---- tunnel ----------------------------------------------------------------
# Reverse-of-reverse: a LOCAL port forward (-L), so a service running on the
# pod (zorro serve :8080, pf serve :11450, ...) answers on localhost on YOUR
# machine — the point being a local coding harness / IDE agent can point at
# http://localhost:8080/v1 and transparently reach the pod's GPU, no pod-side
# awareness needed in the client. Background via `ssh -f -N`; PID tracked so
# `--stop` can find it again (a plain `pkill -f ssh` would risk killing an
# unrelated tunnel — see runpod-ops' own pkill-kills-the-wrong-thing trap).
TUNNEL_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/water-spider/tunnels"

cmd_tunnel() {
  local id="" stop=0 host="" port="" ports=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --stop) stop=1; shift ;;
      --port) ports+=("$2"); shift 2 ;;
      --host) host="$2"; shift 2 ;;
      --pod-port) port="$2"; shift 2 ;;
      *) if [ -z "$id" ]; then id="$1"; shift; else die "tunnel: unexpected arg '$1'"; fi ;;
    esac
  done
  [ -n "$id" ] || die "usage: water-spider tunnel <pod-id> [--port LOCAL:REMOTE ...] [--stop]"
  mkdir -p "$TUNNEL_DIR"
  local pidfile="$TUNNEL_DIR/$id.pid"

  if [ "$stop" = 1 ]; then
    [ -f "$pidfile" ] || die "no tracked tunnel for $id (nothing in $pidfile)"
    local pid; pid="$(cat "$pidfile")"
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid" && echo "==> stopped tunnel for $id (pid $pid)"
    else
      echo "==> pid $pid (from $pidfile) already gone — cleaning up the stale pidfile"
    fi
    rm -f "$pidfile"
    return
  fi

  if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    die "a tunnel for $id is already running (pid $(cat "$pidfile")) — 'water-spider tunnel $id --stop' first"
  fi

  if [ -z "$host" ] || [ -z "$port" ]; then
    local info hp
    info="$(rp_json ssh info "$id")"
    hp="$(ws_resolve_host_port "$info")"; host="${host:-${hp%%:*}}"; port="${port:-${hp##*:}}"
  fi
  if [ -z "$host" ] || [ -z "$port" ]; then
    die "could not resolve pod host/port (see: water-spider connect $id) — pass --host/--pod-port explicitly"
  fi

  [ "${#ports[@]}" -gt 0 ] || ports=("8080:8080" "11450:11450")   # zorro serve / pf serve defaults
  local dashL=()
  for p in "${ports[@]}"; do dashL+=(-L "${p%%:*}:localhost:${p##*:}"); done

  echo "==> tunneling ${ports[*]} to $host:$port (background)"
  ssh -f -N "${dashL[@]}" -p "$port" -i "$SSH_KEY" -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=4 "root@$host" \
    || die "ssh tunnel failed to establish — check host/port/key are right (water-spider connect $id)"
  # ssh -f forks and the parent exits immediately; find the child by matching
  # our exact invocation rather than trusting $! (which is the already-exited
  # parent's pid under -f).
  sleep 1
  local pid
  pid="$(pgrep -f "ssh -f -N .* -p $port -i $SSH_KEY .*root@$host" | head -1 || true)"
  [ -n "$pid" ] || die "tunnel process not found after launch — it may have failed silently, check manually: ps aux | grep 'root@$host'"
  echo "$pid" > "$pidfile"
  for p in "${ports[@]}"; do echo "==> http://localhost:${p%%:*}  ->  pod:${p##*:}"; done
  echo "==> stop with: water-spider tunnel $id --stop"
}

# ---- recipe ------------------------------------------------------------------
# The concrete workflow this exists for: "I want to test model X via engine
# Y from a LOCAL coding harness." Loads the model on the pod (background,
# logged), tunnels the port, prints the ready-to-use local URL. One command
# instead of the ssh+nohup+tunnel dance by hand.
cmd_recipe() {
  local action="${1:?usage: water-spider recipe <list|serve> ...}"; shift
  case "$action" in
    list)
      cat <<'EOF'
Available recipes:
  serve <pod-id> <model-path> [--engine zorro|llama|llama-agent|pf] [--port N]
      Launch a model server on the pod (background, nohup, logged to
      ~/serve.log on the pod) and auto-tunnel its port to localhost.
      --engine zorro (default): `zorro serve <model> --port N`
      --engine llama:           `llama-server -m <model> --port N -ngl 99`
      --engine llama-agent:     llama.cpp's OpenAI-compatible API on pod
                                loopback, with tool calling enabled for a
                                tunneled local coding harness
      --engine pf:               `pf serve` (pf's own config picks the model —
                                  point pf's model registry at <model-path>
                                  first; this recipe does not do that for you)
EOF
      ;;
    serve)
      local id="${1:?usage: water-spider recipe serve <pod-id> <model-path> [--engine E] [--port N]}"
      local model="${2:?usage: water-spider recipe serve <pod-id> <model-path> [--engine E] [--port N]}"
      shift 2
      local engine="zorro" port=8080
      while [ $# -gt 0 ]; do
        case "$1" in
          --engine) engine="$2"; shift 2 ;;
          --port) port="$2"; shift 2 ;;
          *) die "recipe serve: unexpected arg '$1'" ;;
        esac
      done
      local info hp host sshport
      info="$(rp_json ssh info "$id")"
      hp="$(ws_resolve_host_port "$info")"; host="${hp%%:*}"; sshport="${hp##*:}"
      if [ -z "$host" ] || [ -z "$sshport" ]; then
        die "could not resolve pod host/port (see: water-spider connect $id)"
      fi

      local remote_cmd
      case "$engine" in
        zorro) remote_cmd="nohup zorro serve '$model' --port $port > ~/serve.log 2>&1 & disown; sleep 2; ss -ltn | grep ':$port ' && echo LAUNCHED || (echo FAILED; tail -20 ~/serve.log)" ;;
        llama) remote_cmd="nohup llama-server -m '$model' --port $port -ngl 99 > ~/serve.log 2>&1 & disown; sleep 2; ss -ltn | grep ':$port ' && echo LAUNCHED || (echo FAILED; tail -20 ~/serve.log)" ;;
        llama-agent) remote_cmd="nohup llama-server -m '$model' --host 127.0.0.1 --port $port -ngl 999 --jinja --flash-attn auto --alias speedy > ~/serve.log 2>&1 & disown; sleep 2; ss -ltn | grep ':$port ' && echo LAUNCHED || { echo FAILED; tail -20 ~/serve.log; exit 1; }" ;;
        pf)    remote_cmd="nohup pf serve > ~/serve.log 2>&1 & disown; sleep 2; ss -ltn | grep ':$port ' && echo LAUNCHED || (echo FAILED; tail -20 ~/serve.log)" ;;
        *) die "recipe serve: unknown --engine '$engine' (zorro|llama|llama-agent|pf)" ;;
      esac
      echo "==> launching $engine serve on the pod (backgrounded, logged to ~/serve.log there)"
      echo "    NOT live-tested this session — verify the remote_cmd shape on first real use."
      ssh -p "$sshport" -i "$SSH_KEY" "root@$host" "$remote_cmd" \
        || die "remote launch failed — ssh in manually and check ~/serve.log: water-spider connect $id"
      echo "==> tunneling port $port"
      cmd_tunnel "$id" --host "$host" --pod-port "$sshport" --port "$port:$port"
      echo "==> ready: http://localhost:$port  (engine=$engine, model=$model)"
      ;;
    *) die "recipe: unknown action '$action' (list|serve)" ;;
  esac
}

# ---- gui ---------------------------------------------------------------------
# Two transports, xpra preferred:
#
#   xpra (default when the `xpra` binary is present locally): the seamless-
#   window transport x11docker (github.com/mviereck/x11docker, the captain's
#   own reference) itself prefers over raw X11 forwarding for exactly this
#   reason — X11's wire protocol is chatty and was never designed for a real
#   network link, where xpra compresses/batches it AND survives a dropped
#   connection (the remote app keeps running; `xpra attach` again to
#   reconnect — raw X11 forwarding just kills the app when ssh drops).
#   `xpra start ssh://root@HOST:PORT/DISPLAY --start=CMD --ssh="ssh -i KEY"`
#   is the whole thing in one call — xpra owns the ssh connection itself,
#   we don't need to orchestrate a separate ssh session. Syntax verified
#   against xpra's own --help + ArchWiki/xpra.org docs, NOT live-tested (no
#   real remote target available this session).
#
#   --x11 (explicit opt-in, or automatic fallback if `xpra` isn't installed
#   locally): plain `ssh -X`/`-Y` — the same mechanism the "docker-x11"
#   family (this tool's own original reference point) builds on. Simpler,
#   zero extra packages beyond `xauth` on the pod (already fixed in the v3
#   image), but no reconnect-on-drop and worse over real latency.
#
# Either way needs a real X server on THIS machine to render into (any
# normal Linux desktop; macOS needs XQuartz; not attempted on Windows/WSL).
cmd_gui() {
  local id="" host="" port="" trusted=0 force_x11=0 display=100
  while [ $# -gt 0 ]; do
    case "$1" in
      --host) host="$2"; shift 2 ;;
      --pod-port) port="$2"; shift 2 ;;
      --trusted) trusted=1; shift ;;   # x11 mode: -Y instead of -X
      --x11) force_x11=1; shift ;;     # skip xpra even if installed locally
      --display) display="$2"; shift 2 ;;   # xpra mode: which display number to use
      --) shift; break ;;
      *) if [ -z "$id" ]; then id="$1"; shift; else break; fi ;;
    esac
  done
  [ -n "$id" ] || die "usage: water-spider gui <pod-id> [--x11|--trusted] [--] <command...>"
  [ $# -ge 1 ] || die "usage: water-spider gui <pod-id> [--x11|--trusted] [--] <command...> (e.g. water-spider gui $id -- xterm)"
  [ -n "${DISPLAY:-}" ] || echo "$SCRIPT_NAME: WARNING — \$DISPLAY is unset on THIS machine; nothing local to render into" >&2

  if [ -z "$host" ] || [ -z "$port" ]; then
    local info hp
    info="$(rp_json ssh info "$id")"
    hp="$(ws_resolve_host_port "$info")"; host="${host:-${hp%%:*}}"; port="${port:-${hp##*:}}"
  fi
  if [ -z "$host" ] || [ -z "$port" ]; then
    die "could not resolve pod host/port (see: water-spider connect $id) — pass --host/--pod-port explicitly"
  fi

  if [ "$force_x11" != 1 ] && command -v xpra >/dev/null 2>&1; then
    echo "==> launching '$*' on $id via xpra (ssh transport, display :$display) — NOT live-tested this session"
    echo "    (verified against xpra's own --help + published docs, no real remote target to test"
    echo "    against here — if it fails, try 'water-spider gui $id --x11 -- ...' as a fallback,"
    echo "    or reattach later with: xpra attach \"ssh://root@$host:$port/$display\" -i $SSH_KEY)"
    xpra start "ssh://root@$host:$port/$display" \
      --start="$*" --exit-with-children=yes --daemon=no \
      --ssh="ssh -i $SSH_KEY -o StrictHostKeyChecking=accept-new" \
      || die "xpra launch failed — try --x11 for the simpler raw-X11-forwarding fallback"
  else
    local xflag="-X"; [ "$trusted" = 1 ] && xflag="-Y"
    echo "==> launching '$*' on $id with raw X11 forwarding ($xflag) — NOT live-tested this session"
    echo "    (no real X client to verify against in this environment — verify on first real use;"
    echo "    if the window never appears, check: pod has xauth installed, sshd_config has"
    echo "    X11Forwarding yes, and \$DISPLAY is actually set on THIS machine)"
    [ "$force_x11" = 1 ] || echo "    (xpra not found locally — falling back to X11 forwarding; 'apt install xpra' for the more robust transport)"
    ssh "$xflag" -p "$port" -i "$SSH_KEY" "root@$host" "$@"
  fi
}

# ---- snapshot / restore -------------------------------------------------------
# Lightweight config manifest, NOT a filesystem backup — see the header note
# for why. Captures: image provenance (/etc/zorro-image.json, so a restore
# onto a different image build is a loud choice, not a silent mismatch), and
# the model filenames present under ZORRO_MODELS_DIR (re-derivable by name,
# not by copying bytes — a restore re-pulls them via `hf download`, which the
# xet CDN path makes fast, rather than trying to move the file itself).
cmd_snapshot() {
  local id="${1:?usage: water-spider snapshot <pod-id> [-o FILE]}"; shift
  local out="water-spider-snapshot-$id.json"
  [ "${1:-}" = "-o" ] && out="$2"
  local info hp host port
  info="$(rp_json ssh info "$id")"
  hp="$(ws_resolve_host_port "$info")"; host="${hp%%:*}"; port="${hp##*:}"
  if [ -z "$host" ] || [ -z "$port" ]; then
    die "could not resolve pod host/port (see: water-spider connect $id)"
  fi

  echo "==> collecting manifest from $id (NOT live-tested this session)"
  local models provenance
  models="$(ssh -p "$port" -i "$SSH_KEY" "root@$host" \
    'ls "${ZORRO_MODELS_DIR:-/workspace/scratch/models}" 2>/dev/null | jq -R -s "split(\"\n\") | map(select(length>0))"' \
    2>/dev/null || echo '[]')"
  provenance="$(ssh -p "$port" -i "$SSH_KEY" "root@$host" 'cat /etc/zorro-image.json 2>/dev/null || echo "{}"')"
  jq -n --argjson models "$models" --argjson provenance "$provenance" --arg pod "$id" \
    '{pod_id: $pod, image_provenance: $provenance, model_files: $models,
      note: "manifest only — re-provisions by filename via hf download, does not carry bytes"}' \
    > "$out"
  echo "==> wrote $out"
  echo "==> replay on a fresh pod (once running): print the model list and re-pull each"
  echo "    by name — this tool doesn't know which HF repo each file came from, so"
  echo "    restoring is a starting checklist, not a fully automated step yet:"
  jq -r '.model_files[]' "$out" 2>/dev/null | sed 's/^/    - /'
}

# ---- teardown --------------------------------------------------------------
cmd_teardown() {
  local id="" session_name="" pull_paths=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --session-name) session_name="$2"; shift 2 ;;
      --pull) pull_paths+=("$2"); shift 2 ;;
      *) if [ -z "$id" ]; then id="$1"; shift; else die "teardown: unexpected arg '$1'"; fi ;;
    esac
  done
  [ -n "$id" ] || die "usage: water-spider teardown <pod-id> [--session-name NAME] [--pull PATH...]"

  echo "== teardown checklist (runpod-ops §7) =="
  echo "[ ] 1. Read the pod's final sync.txt (if multi-agent) for unpulled findings."
  echo "       water-spider receive $id /workspace/sync.txt ."
  echo "[ ] 2. Results committed + pushed from THIS box (not the pod — it is a"
  echo "       transport, never a repo of record)."
  if [ "${#pull_paths[@]}" -gt 0 ]; then
    echo "[ ] 3. Pull requested small artifacts (you must run these — this tool"
    echo "       only prints the paired commands, see 'send'/'receive' above):"
    for p in "${pull_paths[@]}"; do
      echo "       water-spider receive $id '$p' ${session_name:+workspace-meta/ops/runpod-$session_name/}"
    done
  else
    echo "[ ] 3. (no --pull paths given — pull anything worth keeping BEFORE"
    echo "       confirming below; nothing on the pod survives delete)"
  fi
  echo
  read -r -p "Confirmed 1+2(+3) are done — proceed with pod delete? [y/N] " ans
  case "$ans" in
    y|Y) : ;;
    *) echo "aborted — pod $id is still running and BILLING."; exit 1 ;;
  esac

  echo "==> deleting $id"
  # A failed terminate REQUEST is not fatal here: the fresh listing below is
  # the only thing that decides "gone" vs "still billing" vs UNKNOWN.
  ws_pod_terminate "$id" || echo "⚠️  terminate request reported an error (above) — verifying the real state anyway"

  echo "==> VERIFYING it's actually gone (every idle hour bills):"
  sleep 2
  local still
  # This is the single highest-value check in the whole tool — if the list
  # call itself fails, that must read as "UNKNOWN, go check by hand", never
  # as silent success (the set -e assignment trap this file already hit
  # once would turn a transient network blip into a false all-clear here).
  local fresh
  if ! fresh="$(ws_pods_json)"; then
    echo "⚠️  could not verify — the pod listing query itself failed. UNKNOWN"
    echo "    whether $id is really gone. Check manually: water-spider get $id"
    exit 1
  fi
  still="$(printf '%s' "$fresh" | jq -r --arg id "$id" '.[] | select(.id==$id) | .id')" || { echo "⚠️  could not parse the listing. UNKNOWN whether $id is gone."; exit 1; }
  if [ -n "$still" ]; then
    echo "⚠️  $id STILL LISTED — delete may not have taken. Re-check manually:"
    echo "    water-spider get $id"
    exit 1
  fi
  echo "==> confirmed gone. Remember: stop any local watcher polling this pod"
  echo "    (its ssh now exits 255 and reads as a failure, not a signal)."
}

# ---- gpus ------------------------------------------------------------------
cmd_gpus() {
  local available_only=0
  [ "${1:-}" = "--available" ] && available_only=1
  local filter='.'
  [ "$available_only" = 1 ] && filter='map(select(.available))'
  runpodctl gpu list -o json | jq -r "$filter | .[] | \"\(.gpuId)\t\(.memoryInGb)GB\t\(.stockStatus)\t\(if .communityCloud then \"community\" else \"secure-only\" end)\"" \
    | column -t -s $'\t'
}

# ---- scaffold (optional, fleet-internal) -------------------------------------
# Thin passthrough to `foreman-scaffold` — a nixpt-fleet project bootstrapper
# (dejavue init, .jagent planning board, bump-version --install, gh-ruleset,
# gh repo create). Not part of water-spider's own job (RunPod pod ops); kept
# here only because water-spider itself was scaffolded this way and it's a
# convenient place to reach it from. NOT available outside the nixpt fleet
# checkout layout — every other subcommand works standalone, this one alone
# needs a sibling `jokersquad` checkout on PATH or at the well-known path.
cmd_scaffold() {
  local fs
  fs="$(command -v foreman-scaffold 2>/dev/null || true)"
  [ -x "$fs" ] || fs="/workspace/projects/jokersquad/bin/foreman-scaffold"
  [ -x "$fs" ] || die "foreman-scaffold not found (fleet-internal command, needs a jokersquad checkout — not available outside the nixpt fleet layout)"
  exec "$fs" "$@"
}

# ---- pod visibility: ps / gpu (WATERS-027) -------------------------------------
# READ-ONLY views of what runs INSIDE a pod, with no hand-ssh. One ssh round
# trip per refresh: a single remote script goes over stdin (`ssh ... 'bash -s'`)
# and prints delimited sections (@@WS:name@@) that are rendered locally.
#
# Hard rules (tests/run.sh and tests/docker-rehearsal.sh enforce them):
#   - the remote script only READS: no kill, no writes (not even /tmp), no
#     installs, no heredocs or here-strings (bash may back them with temp
#     files), no /proc/*/environ. A missing tool degrades ("nvidia-smi absent").
#   - secrets are redacted on the remote side before output leaves the pod and
#     again locally (ws_redact_prog is the single source of both).
#   - like `tunnel`, an explicit --host/--pod-port needs NO RunPod API; with
#     only a pod id the endpoint is resolved the way `connect` does.
#   - ControlMaster reuse (private 0700 dir) so --watch is one connection.
#
# The nvidia-smi --query-gpu fields START with the MCP node profile's gpu_status
# set (mcp/src/main.rs: index,name,uuid,memory.used,memory.total,utilization.gpu,
# temperature.gpu,power.draw) so the two surfaces agree; power.limit and clocks
# are appended.
#
# Redaction program (sed -E, GNU): applied remotely AND locally; idempotent.
# Hex runs (WATERS-033): a run of EXACTLY 40 (git/SHA-1) or 64 (SHA-256) hex
# characters passes through (commit ids are the useful part of sync.txt), unless a
# secret-like word (token/key/secret/pass/credential/auth/cookie/jwt/pwd) appears
# earlier on the same line. Any other run of 40+ hex stays masked. When unsure: mask.
ws_redact_prog() {
  cat <<'RED'
s|(://)[^/[:space:]]*@|\1<redacted>@|g
s/([A-Za-z0-9_.-]*(token|key|secret|pass|credential|auth|cookie|jwt|pwd)[A-Za-z0-9_.-]*)=("[^"]*"|'[^']*'|[^[:space:]]+)/\1=<redacted>/Ig
s/(^|[[:space:]])(--?[A-Za-z0-9_-]*(token|key|secret|pass|pwd|cookie|jwt|session-id|auth|user)[A-Za-z0-9_-]*)[[:space:]]+("[^"]*"|'[^']*'|[^-[:space:]][^[:space:]]*|-[^-[:space:]][^[:space:]]*)/\1\2 <redacted>/Ig
s/(^|[[:space:]])(-u)[[:space:]]+[^[:space:]<][^[:space:]]*/\1\2 <redacted>/g
s/(^|[[:space:]])(-p)[[:space:]]+[^0-9[:space:]<][^[:space:]]*/\1\2 <redacted>/g
s#(Bearer|Basic|Token)[[:space:]]+[^[:space:]<]+#\1 <redacted>#Ig
s/([A-Za-z0-9_-]*(token|key|secret|pass|auth)[A-Za-z0-9_-]*:[[:space:]]*)[^[:space:]<:][^[:space:]]*/\1<redacted>/Ig
s/(^|[^A-Za-z0-9])(hf_|sk-|rp_|ghp_|gho_|github_pat_|xox[bp]-|AKIA)[A-Za-z0-9_-]{8,}/\1<redacted>/g
:h
s/((token|key|secret|pass|credential|auth|cookie|jwt|pwd).*[^A-Za-z0-9])[0-9a-fA-F]{40,}([^A-Za-z0-9]|$)/\1<redacted>\3/Ig
th
:b
s/(^|[^A-Za-z0-9])([0-9a-fA-F]{41,63}|[0-9a-fA-F]{65,})([^A-Za-z0-9]|$)/\1<redacted>\3/g
tb
RED
}
ws_redact() { sed -E -e "$(ws_redact_prog)"; }
ws_redact_stream() { sed -u -E -e "$(ws_redact_prog)"; }

# The remote script. Emitted by `water-spider _probe-script` too (the docker
# rehearsal pipes it into a container).
ws_probe_script() {
  printf 'red() { sed -E -e %q; }\n' "$(ws_redact_prog)"
  cat <<'REMOTE'
main() {
  sec() { printf '@@WS:%s@@\n' "$1"; }
  have() { command -v "$1" >/dev/null 2>&1; }
  to() { if have timeout; then timeout 10 "$@"; else "$@"; fi; }
  rd() { local v=""; [ -r "$1" ] && read -r v <"$1"; printf '%s' "$v"; }
  sec meta
  printf 'ts=%s\nhost=%s\nuser=%s\nself=%s\n' "$(date +%s 2>/dev/null)" "$(hostname 2>/dev/null)" "$(id -un 2>/dev/null)" "$$"
  sec cgroup
  if [ -r /sys/fs/cgroup/memory.current ]; then
    printf 'v=2\nmem_current=%s\nmem_max=%s\ncpu_max=%s\n' "$(rd /sys/fs/cgroup/memory.current)" "$(rd /sys/fs/cgroup/memory.max)" "$(rd /sys/fs/cgroup/cpu.max)"
    [ -r /sys/fs/cgroup/cpu.stat ] && while read -r k v; do [ "$k" = usage_usec ] && printf 'cpu_usec=%s\n' "$v"; done </sys/fs/cgroup/cpu.stat
  elif [ -r /sys/fs/cgroup/memory/memory.usage_in_bytes ]; then
    printf 'v=1\nmem_current=%s\nmem_max=%s\ncpu_quota=%s\ncpu_period=%s\n' "$(rd /sys/fs/cgroup/memory/memory.usage_in_bytes)" "$(rd /sys/fs/cgroup/memory/memory.limit_in_bytes)" "$(rd /sys/fs/cgroup/cpu/cpu.cfs_quota_us)" "$(rd /sys/fs/cgroup/cpu/cpu.cfs_period_us)"
  else
    printf 'v=none\n'
  fi
  sec gpu
  if have nvidia-smi; then
    o="$(to nvidia-smi --query-gpu=index,name,uuid,memory.used,memory.total,utilization.gpu,temperature.gpu,power.draw,power.limit,clocks.sm,clocks.mem --format=csv,noheader,nounits 2>&1)" && printf '%s\n' "$o" || printf 'ERR %s\n' "$o"
  else
    echo ABSENT
  fi
  sec gpuproc
  if have nvidia-smi; then
    o="$(to nvidia-smi --query-compute-apps=pid,used_memory,process_name --format=csv,noheader,nounits 2>&1)" && printf '%s\n' "$o" || printf 'ERR %s\n' "$o"
  else
    echo ABSENT
  fi
  sec ps
  if have ps; then
    o="$(to ps -eo user:24=,pid=,ppid=,etimes=,pcpu=,rss=,args= 2>/dev/null)" || o=""
    printf '%s\n' "$o" | red | awk -v s="$$" '$2 != s && $3 != s && $0 !~ /ps -eo user:24=/'
  else
    echo ABSENT
  fi
  sec listen
  l=""
  if have ss && l="$(to ss -ltnp 2>/dev/null)"; then
    echo mode=ss; printf '%s\n' "$l" | red
  elif have netstat && l="$(to netstat -ltnp 2>/dev/null)"; then
    echo mode=netstat; printf '%s\n' "$l" | red
  else
    echo mode=proc
    h4() { printf '%d.%d.%d.%d' "0x${1:6:2}" "0x${1:4:2}" "0x${1:2:2}" "0x${1:0:2}"; }
    for f in /proc/net/tcp /proc/net/tcp6; do
      [ -r "$f" ] || continue
      while read -r _ la _ st _; do
        [ "$st" = 0A ] || continue
        a="${la%%:*}"; p="$(printf '%d' "0x${la##*:}")"
        if [ "${#a}" = 8 ]; then ad="$(h4 "$a")"
        elif [ "${a//0/}" = "" ]; then ad="::"
        elif [ "$a" = 00000000000000000000000001000000 ]; then ad="::1"
        elif [ "${a:0:24}" = 0000000000000000FFFF0000 ]; then ad="::ffff:$(h4 "${a:24:8}")"
        else ad="v6:$a"; fi
        printf 'LISTEN 0 0 %s:%s 0.0.0.0:* -\n' "$ad" "$p"
      done <"$f"
    done
  fi
  sec net
  [ -r /proc/net/dev ] && while read -r l; do printf '%s\n' "$l"; done </proc/net/dev
  sec disk
  to df -P -k / /workspace 2>/dev/null || true
  sec end
}
main </dev/null; exit
REMOTE
}

# Private 0700 ControlMaster socket dir.
ws_cm_dir() {
  local d
  if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ]; then d="$XDG_RUNTIME_DIR/water-spider-cm"
  else d="${XDG_CACHE_HOME:-$HOME/.cache}/water-spider/cm"; fi
  { mkdir -p "$d" && chmod 700 "$d"; } || die "cannot create ControlMaster dir $d"
  [ "$(stat -c %a "$d")" = 700 ] && [ -O "$d" ] || die "ControlMaster dir $d must be mode 0700 and owned by you"
  printf '%s' "$d"
}

# Common option parsing for ps/gpu. Sets V_ID V_HOST V_PORT V_PROBE and V_REST.
ws_vis_parse() {
  V_ID=""; V_HOST=""; V_PORT=""; V_PROBE=""; V_PATH=""; V_REST=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --host) V_HOST="${2:?--host needs a value}"; shift 2 ;;
      --pod-port) V_PORT="${2:?--pod-port needs a value}"; shift 2 ;;
      --probe-file) V_PROBE="${2:?--probe-file needs a value}"; shift 2 ;;   # offline: render a captured probe
      --json|--once|--follow|--sync) V_REST+=("$1"); shift ;;
      --*) V_REST+=("$1"); [ $# -ge 2 ] && [[ "$2" != --* ]] && { V_REST+=("$2"); shift; }; shift ;;
      *) if [ -z "$V_ID" ]; then V_ID="$1"; shift; elif [ -z "$V_PATH" ]; then V_PATH="$1"; shift; else die "unexpected arg '$1'"; fi ;;
    esac
  done
}

ws_vis_resolve() {
  [ -n "$V_PROBE" ] && return 0
  if [ -z "$V_HOST" ] || [ -z "$V_PORT" ]; then
    [ -n "$V_ID" ] || die "need a <pod-id>, or both --host and --pod-port"
    [[ "$V_ID" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid pod id: $V_ID"
    local info hp
    info="$(rp_json ssh info "$V_ID")"
    hp="$(ws_resolve_host_port "$info")"; V_HOST="${V_HOST:-${hp%%:*}}"; V_PORT="${V_PORT:-${hp##*:}}"
  fi
  [ -n "$V_HOST" ] && [ -n "$V_PORT" ] || die "could not resolve pod host/port (see: water-spider connect $V_ID) — pass --host/--pod-port explicitly"
  [[ "$V_HOST" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "invalid --host: $V_HOST"
  [[ "$V_PORT" =~ ^[0-9]{1,5}$ ]] && [ "$V_PORT" -ge 1 ] && [ "$V_PORT" -le 65535 ] || die "invalid --pod-port: $V_PORT"
}

# ssh argv shared by every visibility command ($1 = ControlMaster mode).
ws_ssh_args() {
  local cm; cm="$(ws_cm_dir)" || return 1
  WS_SSH=(-T -p "$V_PORT" -i "$SSH_KEY" -o IdentitiesOnly=yes
    -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=10 -o ServerAliveCountMax=3
    -o StrictHostKeyChecking=accept-new
    "root@$V_HOST")
  if [ "${1:-auto}" = none ]; then WS_SSH=("${WS_SSH[@]:0:${#WS_SSH[@]}-1}" -o ControlMaster=no -o ControlPath=none "root@$V_HOST")
  else WS_SSH=("${WS_SSH[@]:0:${#WS_SSH[@]}-1}" -o ControlMaster=auto -o "ControlPath=$cm/%C" -o ControlPersist=60 "root@$V_HOST"); fi
}

# One ssh round trip -> $1 (a local file). Never leaves a pipe for the
# ControlPersist master to hold open.
ws_vis_fetch() {
  local out="$1" rc=0
  if [ -n "$V_PROBE" ]; then
    ws_redact <"$V_PROBE" >"$out"; return 0
  fi
  ws_ssh_args auto || return 1
  ws_probe_script | ssh "${WS_SSH[@]}" 'bash -s' >"$out.raw" 2>"$out.err" || rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "$SCRIPT_NAME: ssh to $V_HOST:$V_PORT failed (rc=$rc): $(ws_redact <"$out.err" | tail -3 | tr '\n' ' ')" >&2
    return 1
  fi
  ws_redact <"$out.raw" >"$out"          # second, local redaction pass
  grep -q '^@@WS:end@@$' "$out" || { echo "$SCRIPT_NAME: probe output truncated (no end marker)" >&2; return 1; }
}

ws_hostport() { case "$1" in *:*) printf '[%s]:%s' "$1" "$2" ;; *) printf '%s:%s' "$1" "$2" ;; esac; }
ws_sec() { awk -v n="@@WS:$2@@" '$0==n{f=1;next} /^@@WS:/{f=0} f' "$1"; }

ws_hb() { awk -v b="${1:-0}" 'BEGIN{ if (b !~ /^[0-9]+$/) {print "?"; exit} u="B KiB MiB GiB TiB"; split(u,s," "); i=1; while (b>=1024 && i<5){b/=1024;i++} printf (i==1?"%d %s":"%.1f %s"), b, s[i] }'; }

# Render one snapshot. $1 = probe file, $2 = ps|gpu, $3 = ps row limit.
ws_vis_render() {
  local f="$1" mode="$2" limit="${3:-40}" t="$WS_TMP"
  local flags="$t/flags"; : >"$flags"
  local label="${V_ID:-$V_HOST:$V_PORT}"
  ws_sec "$f" meta >"$t/meta"; ws_sec "$f" cgroup >"$t/cg"; ws_sec "$f" gpu >"$t/gpu"
  ws_sec "$f" gpuproc >"$t/gp"; ws_sec "$f" net >"$t/net"; ws_sec "$f" ps >"$t/ps"; ws_sec "$f" listen >"$t/ls"; ws_sec "$f" disk >"$t/disk"
  kv() { sed -n "s/^$2=//p" "$1" | head -1; }
  printf '== pod %s  host %s  at %s (UTC)\n' "$label" "$(kv "$t/meta" host)" "$(date -u +%H:%M:%S)"

  # container limits (cgroup), never /proc/meminfo (that is the host)
  local v mc mm cm_
  v="$(kv "$t/cg" v)"; mc="$(kv "$t/cg" mem_current)"; mm="$(kv "$t/cg" mem_max)"
  if [ "$v" = 2 ] || [ "$v" = 1 ]; then
    local cpu="unlimited"
    if [ "$v" = 2 ]; then
      cm_="$(kv "$t/cg" cpu_max)"
      [[ "$cm_" =~ ^([0-9]+)\ ([0-9]+)$ ]] && cpu="$(awk -v q="${BASH_REMATCH[1]}" -v p="${BASH_REMATCH[2]}" 'BEGIN{printf "%.1f vCPU", q/p}')"
    else
      local q p; q="$(kv "$t/cg" cpu_quota)"; p="$(kv "$t/cg" cpu_period)"
      [[ "$q" =~ ^[0-9]+$ ]] && [[ "$p" =~ ^[0-9]+$ ]] && [ "$p" -gt 0 ] && cpu="$(awk -v q="$q" -v p="$p" 'BEGIN{printf "%.1f vCPU", q/p}')"
    fi
    local mem; mem="$(ws_hb "$mc")"
    if [[ "$mm" =~ ^[0-9]+$ ]] && [ "$mm" -lt 4611686018427387904 ]; then mem="$mem / $(ws_hb "$mm") ($(awk -v a="$mc" -v b="$mm" 'BEGIN{printf "%d", a*100/b}')%)"; else mem="$mem / unlimited"; fi
    printf 'container (cgroup v%s): mem %s   cpu limit %s   [cgroup, not host /proc/meminfo]\n' "$v" "$mem" "$cpu"
  else
    printf 'container: cgroup limits unavailable (no cgroup v1/v2 files readable)\n'
  fi

  # GPU
  local gl; gl="$(head -1 "$t/gpu")"
  if [ "$gl" = ABSENT ]; then echo "gpu: nvidia-smi absent"
  elif [[ "$gl" == ERR* ]]; then echo "gpu: nvidia-smi failed: ${gl#ERR }"
  else
    local i name ut mu mt pw pl tp sm me
    while IFS=, read -r i name _ mu mt ut tp pw pl sm me; do
      i="${i// /}"; name="${name# }"
      printf 'GPU%s %s  util %s%%  VRAM %s/%s MiB  pwr %s/%s W  temp %sC  SM %s MHz  mem %s MHz\n' "$i" "$name" "${ut// /}" "${mu// /}" "${mt// /}" "${pw// /}" "${pl// /}" "${tp// /}" "${sm// /}" "${me// /}"
      if [[ "${mu// /}" =~ ^[0-9]+$ ]] && [[ "${mt// /}" =~ ^[0-9]+$ ]] && [ "${mt// /}" -gt 0 ] && [ $(( ${mu// /} * 100 )) -gt $(( ${mt// /} * 95 )) ]; then
        echo "VRAM on GPU$i is ${mu// /}/${mt// /} MiB (> 95%): next allocation may OOM" >>"$flags"
      fi
    done <"$t/gpu"
  fi

  # GPU processes: pid -> VRAM (join with ps)
  : >"$t/vram"; : >"$t/listeners.tsv"
  local gp
  gp="$(head -1 "$t/gp")"
  if [ "$gp" != ABSENT ] && [[ "$gp" != ERR* ]]; then
    local pid used pname
    while IFS=, read -r pid used pname; do
      pid="${pid// /}"; used="${used// /}"; pname="${pname# }"
      [[ "$pid" =~ ^[0-9]+$ ]] || continue
      printf '%s %s\n' "$pid" "${used:-?}" >>"$t/vram"
      local row; row="$(awk -v p="$pid" '$2==p{print; exit}' "$t/ps")"
      if [ -z "$row" ]; then
        echo "GPU process pid $pid (${pname:-?}, ${used} MiB) is not visible in this container's process table: owner/parent unidentifiable (pid namespace?), SIGKILL-prone" >>"$flags"
      else
        local ppid; ppid="$(awk '{print $3}' <<<"$row")"
        [ "$ppid" = 1 ] || [ "$ppid" = 0 ] && echo "GPU process pid $pid (${pname:-?}) is reparented to pid $ppid (no shell/supervisor parent holds it; normal for nohup under a container entrypoint): SIGKILL-prone" >>"$flags"
      fi
    done <"$t/gp"
  fi

  [ "$mode" != top ] || ws_vis_topextra "$t"
  if [ "$mode" = gpu ]; then
    echo "-- GPU processes (VRAM MiB)"
    if [ "$gp" = ABSENT ]; then echo "   nvidia-smi absent"
    elif [[ "$gp" == ERR* ]]; then echo "   nvidia-smi failed"
    elif [ ! -s "$t/vram" ]; then echo "   none reported (a container may not see host-pid compute apps)"
    else
      printf '   %-8s %-10s %-10s %s\n' PID USER "VRAM(MiB)" CMD
      while read -r pid used; do
        awk -v p="$pid" -v u="$used" '$2==p{c=""; for(i=7;i<=NF;i++) c=c (i>7?" ":"") $i; if(length(c)>100) c=substr(c,1,97) "..."; printf "   %-8s %-10s %-10s %s\n", $2, $1, u, c; f=1} END{if(!f) printf "   %-8s %-10s %-10s %s\n", p, "?", u, "(not in container pid table)"}' "$t/ps"
      done <"$t/vram"
    fi
  else
    echo "-- processes: $(wc -l <"$t/ps" | tr -d ' ') total, top $limit by $([ "$mode" = top ] && echo CPU || echo "VRAM then CPU")"
    if [ "$(head -1 "$t/ps")" = ABSENT ]; then echo "   ps absent"
    else
      printf '   %-10s %-7s %-7s %-9s %5s %9s %9s  %s\n' USER PID PPID ELAPSED "%CPU" RSS "VRAM(MiB)" CMD
      awk -v vf="$t/vram" -v w="${WS_WIDTH:-110}" -v cpuonly="$([ "$mode" = top ] && echo 1 || echo 0)" '
        function el(s,  d,h,m){ d=int(s/86400); h=int((s%86400)/3600); m=int((s%3600)/60);
          if(d>0) return sprintf("%dd%02dh",d,h); if(h>0) return sprintf("%dh%02dm",h,m); if(m>0) return sprintf("%dm%02ds",m,s%60); return s "s" }
        BEGIN{ while((getline l < vf)>0){split(l,a," "); v[a[1]]=a[2]} }
        { c=""; for(i=7;i<=NF;i++) c=c (i>7?" ":"") $i; if(length(c)>w) c=substr(c,1,w-3) "...";
          vr=($2 in v)?v[$2]:"-"; vk=(($2 in v) && !cpuonly)?((v[$2]+0)+1):0;
          printf "%d\t%s\t   %-10s %-7s %-7s %-9s %5s %9s %9s  %s\n", vk, $5, substr($1,1,10), $2, $3, el($4), $5, sprintf("%.0fM",$6/1024), vr, c }' "$t/ps" \
        | sort -t "$(printf '\t')" -k1,1nr -k2,2nr | head -n "$limit" | cut -f3- || true   # head may close early: SIGPIPE must not abort under pipefail
    fi
  fi
  # listeners: shown by ps; flags are computed for both views
  local mode_ l; mode_="$(kv "$t/ls" mode)"
  if [ "$mode" = ps ]; then
    echo "-- listening sockets"
    printf '   %-9s %-28s %-8s %s\n' EXPOSURE ADDRESS PORT PROCESS
  fi
  while read -r l; do
      local la="" pr="" st="" rest
      case "$mode_" in
        ss)      read -r st _ _ la _ pr <<<"$l"; [ "$st" = LISTEN ] || continue ;;
        netstat) read -r _ _ _ la _ st pr <<<"$l"; [ "$st" = LISTEN ] || continue ;;
        proc)    read -r st _ _ la _ pr <<<"$l"; [ "$st" = LISTEN ] || continue ;;
        *) continue ;;
      esac
      local port="${la##*:}" addr="${la%:*}"; addr="${addr#[}"; addr="${addr%]}"; addr="${addr%%%*}"
      local exp=PUBLIC
      [[ "$addr" =~ ^127\. ]] || [ "$addr" = "::1" ] || [[ "$addr" =~ ^::ffff:127\. ]] && exp=LOOPBACK
      [ -n "$pr" ] || pr="-"
      local pname="$pr"
      [[ "$pr" =~ \(\(\"([^\"]+)\" ]] && pname="${BASH_REMATCH[1]}"
      [[ "$pr" =~ ^[0-9]+/(.+)$ ]] && pname="${BASH_REMATCH[1]}"
      printf '%s\t%s\t%s\t%s\n' "$exp" "${addr:-*}" "$port" "$pr" >>"$t/listeners.tsv"
      [ "$mode" != ps ] || printf '   %-9s %-28s %-8s %s\n' "$exp" "${addr:-*}" "$port" "$pr"
      if [ "$exp" = PUBLIC ] && [ "${pname#sshd}" = "$pname" ]; then
        if [ "$pname" = "-" ] && [ "$mode_" = proc ] && [ "$port" = 22 ]; then :
        elif [ "$pname" = "-" ]; then echo "PUBLIC listener $(ws_hostport "${addr:-*}" "$port") (owner unknown: ${mode_} gave no process info), not shown to be sshd" >>"$flags"
        else echo "PUBLIC listener $(ws_hostport "${addr:-*}" "$port") owned by $pname (not sshd)" >>"$flags"; fi
      fi
  done < <(grep -v '^mode=' "$t/ls")

  # disk
  echo "-- disk"
  awk 'NR>1 && ($6=="/" || $6=="/workspace"){printf "   %-12s %s used of %.1f GiB (%.1f GiB free)\n", $6, $5, $2/1048576, $4/1048576}' "$t/disk"
  [ -s "$t/disk" ] || echo "   df unavailable"
  awk 'NR>1 && ($6=="/" || $6=="/workspace"){c=$5; sub("%","",c); if (c+0>90) printf "disk %s is %s%% full (> 90%%)\n", $6, c}' "$t/disk" >>"$flags"

  if [ -s "$flags" ]; then while read -r l; do printf '⚠️  %s\n' "$l"; done <"$flags"
  else echo "ok: no risk flags (public listeners, orphaned GPU procs, disk > 90%, VRAM > 95%)"; fi
}


# --- WATERS-028 helpers ----------------------------------------------------
# Spend since T0 from the RunPod balance (optional: omitted without the API).
# T0 = --t0-balance, else the first balance this process saw. Cached 60 s.
WS_SPEND_JSON="null"; WS_SPEND_LINE=""; WS_T0=""; WS_SPEND_AT=0
ws_spend_update() {
  local now bal
  now="$(date +%s)"
  [ $((now - WS_SPEND_AT)) -ge 60 ] || return 0
  WS_SPEND_AT="$now"
  bal="$(timeout 10 runpodctl user -o json 2>/dev/null | jq -r '.clientBalance // empty' 2>/dev/null || true)"
  if ! [[ "$bal" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then WS_SPEND_JSON="null"; WS_SPEND_LINE=""; return 0; fi
  [ -n "$WS_T0" ] || WS_T0="$bal"
  WS_SPEND_JSON="$(jq -cn --argjson b "$bal" --argjson t "$WS_T0" '{balance_usd:$b, t0_balance_usd:$t, spent_usd:((($t-$b)*100|round)/100)}')"
  WS_SPEND_LINE="$(awk -v a="$WS_T0" -v b="$bal" 'BEGIN{printf "spend: $%.2f since T0 (account balance delta; balance $%.2f, T0 $%.2f)", a-b, b, a}')"
}

# net rx/tx (non-lo) and cgroup cpu usage, with rates from the previous tick.
WS_PREV_TS=""; WS_PREV_RX=0; WS_PREV_TX=0; WS_PREV_CPU=""
ws_vis_topextra() {
  local t="$1" ts rx tx cu rate=""
  ts="$(sed -n 's/^ts=//p' "$t/meta" | head -1)"
  read -r rx tx < <(awk -F'[: ]+' '/:/ && $2!="lo"{r+=$3; x+=$11} END{printf "%d %d\n", r, x}' "$t/net")
  if [[ "$ts" =~ ^[0-9]+$ ]] && [[ "$WS_PREV_TS" =~ ^[0-9]+$ ]] && [ "$ts" -gt "$WS_PREV_TS" ] && [ "$rx" -ge "$WS_PREV_RX" ] && [ "$tx" -ge "$WS_PREV_TX" ]; then
    rate="$(awk -v dr="$((rx - WS_PREV_RX))" -v dx="$((tx - WS_PREV_TX))" -v dt="$((ts - WS_PREV_TS))" 'BEGIN{printf "  (rx %.2f MB/s, tx %.2f MB/s)", dr/dt/1e6, dx/dt/1e6}')"
  fi
  printf 'net (non-lo): rx %s  tx %s%s\n' "$(ws_hb "$rx")" "$(ws_hb "$tx")" "$rate"
  cu="$(sed -n 's/^cpu_usec=//p' "$t/cg" | head -1)"
  if [[ "$cu" =~ ^[0-9]+$ ]] && [[ "$WS_PREV_CPU" =~ ^[0-9]+$ ]] && [[ "$ts" =~ ^[0-9]+$ ]] && [[ "$WS_PREV_TS" =~ ^[0-9]+$ ]] && [ "$ts" -gt "$WS_PREV_TS" ] && [ "$cu" -ge "$WS_PREV_CPU" ]; then
    awk -v d="$((cu - WS_PREV_CPU))" -v dt="$((ts - WS_PREV_TS))" 'BEGIN{printf "cpu used: %.2f vCPU (cgroup usage delta)\n", d/dt/1e6}'
  else
    if [ -z "$cu" ]; then echo "cpu used: unavailable (no cgroup v2 cpu.stat)"; else echo "cpu used: needs two samples (next refresh)"; fi
  fi
  WS_PREV_TS="$ts"; WS_PREV_RX="$rx"; WS_PREV_TX="$tx"; WS_PREV_CPU="$cu"
  [ -z "$WS_SPEND_LINE" ] || echo "$WS_SPEND_LINE"
}

# One JSON line: ps + gpu + mem + disk + net + listeners + spend + flags.
# $1 = probe file; run ws_vis_render >/dev/null first so $WS_TMP is populated.
ws_vis_json() {
  local f="$1" t="$WS_TMP"
  ws_sec "$f" meta >"$t/meta"
  jq -cn \
    --arg label "${V_ID:-$V_HOST:$V_PORT}" \
    --arg host "$(sed -n 's/^host=//p' "$t/meta" | head -1)" \
    --arg ts "$(sed -n 's/^ts=//p' "$t/meta" | head -1)" \
    --rawfile gpu "$t/gpu" --rawfile ps "$t/ps" --rawfile vram "$t/vram" --rawfile cg "$t/cg" \
    --rawfile disk "$t/disk" --rawfile net "$t/net" --rawfile ls "$t/listeners.tsv" --rawfile flags "$t/flags" \
    --argjson spend "$WS_SPEND_JSON" '
    def n: try tonumber catch null;
    def lines: split("\n") | map(select(length>0));
    ($vram | lines | map(split(" ")) | map({key:.[0], value:(.[1]|n)}) | from_entries) as $vm
    | {ts:($ts|n), label:$label, host:$host,
       gpus: [ $gpu | lines | .[] | select((startswith("ABSENT")|not) and (startswith("ERR")|not)) | split(", ")
         | {index:(.[0]|n), name:.[1], uuid:.[2], vram_used_mib:(.[3]|n), vram_total_mib:(.[4]|n), util_pct:(.[5]|n), temp_c:(.[6]|n), power_w:(.[7]|n), power_limit_w:(.[8]|n), sm_mhz:(.[9]|n), mem_mhz:(.[10]|n)} ],
       gpu_available: (($gpu|lines|first // "ABSENT") | ((startswith("ABSENT")|not) and (startswith("ERR")|not))),
       procs: [ $ps | lines | .[] | select(. != "ABSENT")
         | capture("^(?<user>\\S+)\\s+(?<pid>[0-9]+)\\s+(?<ppid>[0-9]+)\\s+(?<et>[0-9]+)\\s+(?<cpu>[0-9.]+)\\s+(?<rss>[0-9]+)\\s+(?<cmd>.*)$")
         | {user, pid:(.pid|n), ppid:(.ppid|n), elapsed_s:(.et|n), cpu_pct:(.cpu|n), rss_kib:(.rss|n), cmd, vram_mib:($vm[.pid])} ],
       mem: ($cg | lines | map(select(contains("=")) | split("=") | {key:.[0], value:(.[1:]|join("="))}) | from_entries
             | {cgroup:.v, current_bytes:(.mem_current|n), max_bytes:(.mem_max|n), cpu_max:.cpu_max, cpu_usec:(.cpu_usec|n)}),
       disk: [ $disk | lines | .[1:][] | [splits(" +")] | select(.[5] == "/" or .[5] == "/workspace")
         | {mount:.[5], size_kib:(.[1]|n), used_kib:(.[2]|n), avail_kib:(.[3]|n), used_pct:(.[4]|rtrimstr("%")|n)} ],
       net: ([ $net | lines | .[] | select(contains(":")) | gsub(":"; " ") | split(" ") | map(select(length>0)) | select(.[0] != "lo") | {rx:(.[1]|n), tx:(.[9]|n)} ] | {rx_bytes:(map(.rx)|add), tx_bytes:(map(.tx)|add)}),
       listeners: [ $ls | lines | .[] | split("\t") | {exposure:.[0], addr:.[1], port:(.[2]|n), process:.[3]} ],
       spend: $spend,
       flags: ($flags | lines) }'
}

# Shared driver for `ps`, `gpu`, `top` and `watch`.
cmd_pod_view() {
  local mode="$1"; shift
  ws_vis_parse "$@"
  [ -z "$V_PATH" ] || die "$mode: unexpected arg '$V_PATH'"
  local watch="" limit=40 i=0 json=0 out="" interval="" once=0
  [ "$mode" != top ] || limit=8
  while [ "$i" -lt "${#V_REST[@]}" ]; do
    case "${V_REST[$i]}" in
      --watch) [ "$mode" = gpu ] || die "$mode: --watch is only for gpu"; watch="${V_REST[$((i+1))]:-}"; i=$((i+2)) ;;
      --limit) { [ "$mode" = ps ] || [ "$mode" = top ]; } || die "$mode: --limit is only for ps/top"; limit="${V_REST[$((i+1))]:-}"; i=$((i+2)) ;;
      --interval) { [ "$mode" = top ] || [ "$mode" = watch ]; } || die "$mode: --interval is only for top/watch"; interval="${V_REST[$((i+1))]:-}"; i=$((i+2)) ;;
      --once) [ "$mode" = top ] || die "$mode: --once is only for top"; once=1; i=$((i+1)) ;;
      --json) [ "$mode" = watch ] || die "$mode: --json is only for watch"; json=1; i=$((i+1)) ;;
      --out) [ "$mode" = watch ] || die "$mode: --out is only for watch"; out="${V_REST[$((i+1))]:-}"; i=$((i+2)) ;;
      --t0-balance) { [ "$mode" = top ] || [ "$mode" = watch ]; } || die "$mode: --t0-balance is only for top/watch"; WS_T0="${V_REST[$((i+1))]:-}"; [[ "$WS_T0" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "--t0-balance must be a number"; i=$((i+2)) ;;
      *) die "$mode: unknown option '${V_REST[$i]}'" ;;
    esac
  done
  [[ "$limit" =~ ^[0-9]+$ ]] && [ "$limit" -ge 1 ] || die "--limit must be a positive integer"
  case "$mode" in
    top)   [ "$once" = 1 ] || watch="${interval:-10}" ;;
    watch) [ "$json" = 1 ] || die "watch: only --json output is implemented (pass --json)"; watch="${interval:-10}" ;;
  esac
  if [ -n "$watch" ]; then
    [[ "$watch" =~ ^[0-9]+$ ]] && [ "$watch" -ge 5 ] || die "refresh interval needs an integer N >= 5 (seconds)"
  fi
  [ -n "$V_ID$V_HOST$V_PROBE" ] || die "usage: water-spider $mode <pod-id> [--host H --pod-port P]"
  ws_vis_resolve
  if [ -n "$out" ]; then
    { [ ! -e "$out" ] || { [ -f "$out" ] && [ ! -L "$out" ]; }; } || die "--out must be a new or regular (non-symlink) file: $out"
    { ( umask 077; : >>"$out" ) && chmod 600 "$out"; } || die "cannot write --out $out"
  fi
  WS_TMP="$(mktemp -d)"; trap 'rm -rf "$WS_TMP"' EXIT
  local tick=0 fails=0 max="${WATER_SPIDER_WATCH_MAX_TICKS:-0}"
  while :; do
    tick=$((tick+1))
    if ws_vis_fetch "$WS_TMP/probe"; then
      fails=0
      if [ "$mode" = top ] || [ "$mode" = watch ]; then ws_spend_update; fi
      if [ "$mode" = watch ]; then
        ws_vis_render "$WS_TMP/probe" ps "$limit" >/dev/null
        local line; line="$(ws_vis_json "$WS_TMP/probe")" || die "could not build the JSON snapshot"
        printf '%s\n' "$line"
        [ -z "$out" ] || printf '%s\n' "$line" >>"$out"
      else
        if [ -n "$watch" ] && [ -t 1 ]; then printf '\033[H\033[2J'; fi
        ws_vis_render "$WS_TMP/probe" "$mode" "$limit"
      fi
    else
      fails=$((fails+1))
      if [ "$mode" = watch ]; then
        local eline; eline="$(jq -cn --arg label "${V_ID:-$V_HOST:$V_PORT}" --argjson ts "$(date +%s)" '{ts:$ts,label:$label,error:"probe failed"}')"
        printf '%s\n' "$eline"; [ -z "$out" ] || printf '%s\n' "$eline" >>"$out"
      fi
      [ -n "$watch" ] || exit 1
      [ "$fails" -lt 5 ] || die "5 consecutive probe failures, giving up"
    fi
    [ -n "$watch" ] || break
    [ "$max" -eq 0 ] || [ "$tick" -lt "$max" ] || break
    [ "$mode" = watch ] || echo "(refresh every ${watch}s, Ctrl-C to stop)"
    sleep "$watch"
  done
}

# ---- logs (WATERS-028/029/030) ---------------------------------------------------
# Read-only tail of one file on the pod. The script goes over stdin like the
# probe; output is redacted on the pod and again locally. --follow is ONE long
# ssh, no polling.
#
# ws_logs_guard_src prints the allowlist + credential deny list as shell
# functions. It is the SINGLE source: the pod script embeds it and runs it on the
# `readlink -f` resolved path (and again on the opened fd, WATERS-030); the local
# pre-check evals the same text on the literal path. Matching is case-insensitive
# (nocasematch). A deny list layered on the allowlist; it never widens it.
ws_logs_guard_src() {
  cat <<'GUARD'
ws_logs_in_roots() {
  local p="$1" root
  for root in $WS_LOGS_ROOTS; do
    case "$p" in "$root"/*) return 0 ;; esac
  done
  return 1
}
ws_logs_denied() (   # subshell: nocasematch must not leak into ws_logs_in_roots
  p="$1"
  shopt -s nocasematch
  case "$p" in
    # shell / REPL / tool history
    *_history|*/.history|*/.lesshst|*/.viminfo|*/.zhistory|*/.sh_history) return 0 ;;
    # credential stores
    */.netrc|*/_netrc|*/.git-credentials|*/.npmrc|*/.pypirc|*/.pgpass|*/.my.cnf|*/.dockercfg) return 0 ;;
    # key and certificate material
    *.pem|*.key|*.p12|*.pfx|*.jks|*.keystore|*.ppk|*_key|*_key.*) return 0 ;;
    # dotenv files
    *.env|*/.env*) return 0 ;;
    # credential directories
    */.git/*|*/.ssh/*|*/.aws/*|*/.config/*|*/.huggingface/*|*/.cache/huggingface/*|*/.docker/*|*/.runpod/*|*/.gnupg/*|*/.kube/*|*/.azure/*) return 0 ;;
    # secret-looking names
    *passw*|*secret*|*token*|*credential*|*apikey*|*api_key*|*api-key*) return 0 ;;
  esac
  case "${p##*/}" in
    *.pub) return 1 ;;    # a public key is not a secret
    id_*|*id_rsa*|*id_ed25519*|*id_ecdsa*|*id_dsa*) return 0 ;;
  esac
  return 1
)
GUARD
}

ws_logs_script() {
  local path="$1" lines="$2" follow="$3" roots="${4:-/workspace /var/log /tmp}"   # roots: tests only (_logs-script)
  printf 'red() { sed -u -E -e %q; }\n' "$(ws_redact_prog)"
  printf 'WS_LOGS_ROOTS=%q\n' "$roots"
  ws_logs_guard_src
  printf 'f=%q\n' "$path"
  printf 'n=%s\n' "$lines"
  if [ "$follow" = 1 ]; then printf 'fl=1\n'; else printf 'fl=0\n'; fi
  cat <<'REMOTE'
main() {
  local r rr
  r="$(readlink -f -- "$f" 2>/dev/null)" || r=""
  if ! ws_logs_in_roots "$r"; then
    echo "water-spider: $f resolves to '$r', outside the readable roots ($WS_LOGS_ROOTS): refused" >&2; return 2
  fi
  if ws_logs_denied "$r"; then echo "water-spider: $r can hold credentials: refused" >&2; return 2; fi
  if [ ! -f "$r" ] || [ ! -r "$r" ]; then echo "water-spider: $r is not a readable regular file on the pod" >&2; return 2; fi
  # Open ONCE, then re-verify what we actually hold: a path component swapped for a
  # symlink after the check above shows up as a different /proc/self/fd/3 target.
  exec 3<"$r" || { echo "water-spider: cannot open $r: refused" >&2; return 2; }
  rr="$(readlink -f -- /proc/self/fd/3 2>/dev/null)" || rr=""
  if ! ws_logs_in_roots "$rr" || ws_logs_denied "$rr" || [ ! -f /proc/self/fd/3 ]; then
    echo "water-spider: $r changed after the check (opened '$rr'): refused" >&2; return 2
  fi
  # tail reads fd 3 only (never the path again). --pid: tail exits when the ssh session (our parent)
  # is gone, so no tail is left behind after Ctrl-C. -f follows the opened inode (not a rotated name).
  if [ "$fl" = 1 ]; then tail -n "$n" -f --pid="$PPID" <&3 2>&1 | red; else tail -n "$n" <&3 2>&1 | red; fi
}
main </dev/null; exit
REMOTE
}

cmd_logs() {
  ws_vis_parse "$@"
  local follow=0 sync=0 lines=100 i=0 path="$V_PATH"
  if [ -z "$path" ] && [[ "$V_ID" == /* ]]; then path="$V_ID"; V_ID=""; fi
  while [ "$i" -lt "${#V_REST[@]}" ]; do
    case "${V_REST[$i]}" in
      --follow) follow=1; i=$((i+1)) ;;
      --sync) sync=1; i=$((i+1)) ;;
      --lines) lines="${V_REST[$((i+1))]:-}"; i=$((i+2)) ;;
      *) die "logs: unknown option '${V_REST[$i]}'" ;;
    esac
  done
  [[ "$lines" =~ ^[0-9]+$ ]] && [ "$lines" -ge 1 ] && [ "$lines" -le 5000 ] || die "--lines must be 1..5000"
  [ "$sync" = 0 ] || { [ -z "$path" ] || die "logs: --sync and a path are exclusive"; path=/workspace/sync.txt; }
  [ -n "$V_ID$V_HOST" ] || die "usage: water-spider logs <pod-id> [<path>|--sync] [--follow] [--lines N] [--host H --pod-port P]"
  ws_vis_resolve
  if [ -z "$path" ]; then
    [ "$follow" = 0 ] || die "logs: --follow needs a path or --sync"
    echo "no path given; recent log-like files under /workspace (pass one, or --sync):"
    ws_ssh_args auto || exit 1
    printf '%s\n' 'ls -1t /workspace/*.log /workspace/*.txt /workspace/results/*.log /workspace/logs/*.log 2>/dev/null | head -20' \
      | ssh "${WS_SSH[@]}" 'bash -s' 2>&1 | ws_redact
    return 0
  fi
  [[ "$path" =~ ^/[A-Za-z0-9._/@+-]+$ ]] || die "logs: path must be absolute and plain ([A-Za-z0-9._/@+-])"
  case "$path" in
    *//*|*/./*|*/.|*..*) die "logs: refusing a non-canonical path (//, /./, ..): $path" ;;
  esac
  # same guard text the pod runs (ws_logs_guard_src), here on the literal path
  eval "$(ws_logs_guard_src)"
  # shellcheck disable=SC2034  # read by ws_logs_in_roots (eval'd above)
  WS_LOGS_ROOTS="/workspace /var/log /tmp"
  ws_logs_in_roots "$path" || die "logs: only /workspace, /var/log and /tmp are readable (refusing a path outside them): $path"
  ! ws_logs_denied "$path" || die "logs: refusing a path that can hold credentials: $path"
  if [ -n "$V_PROBE" ]; then ws_redact <"$V_PROBE"; return 0; fi   # offline: render a captured log
  ws_ssh_args "$([ "$follow" = 1 ] && echo none || echo auto)" || exit 1
  ws_logs_script "$path" "$lines" "$follow" | ssh "${WS_SSH[@]}" 'bash -s' 2>&1 | ws_redact_stream
}

cmd_ps()  { cmd_pod_view ps "$@"; }
cmd_gpu() { cmd_pod_view gpu "$@"; }
cmd_top() { cmd_pod_view top "$@"; }
cmd_watch() { cmd_pod_view watch "$@"; }

# ---- dispatch ---------------------------------------------------------------
[ $# -ge 1 ] || { usage; exit 1; }
sub="$1"; shift
case "$sub" in
  create)    cmd_create "$@" ;;
  list|ls)   cmd_list "$@" ;;
  status)    cmd_status "$@" ;;
  get)       cmd_get "$@" ;;
  connect)   cmd_connect "$@" ;;
  send)      cmd_send "$@" ;;
  receive)   cmd_receive "$@" ;;
  tunnel)    cmd_tunnel "$@" ;;
  recipe)    cmd_recipe "$@" ;;
  gui)       cmd_gui "$@" ;;
  snapshot)  cmd_snapshot "$@" ;;
  teardown)  cmd_teardown "$@" ;;
  gpus)      cmd_gpus "$@" ;;
  scaffold)  cmd_scaffold "$@" ;;
  ps)        cmd_ps "$@" ;;
  gpu)       cmd_gpu "$@" ;;
  top)       cmd_top "$@" ;;
  logs)      cmd_logs "$@" ;;
  watch)     cmd_watch "$@" ;;
  _probe-script) ws_probe_script ;;   # internal: the read-only remote script (tests)
  _redact-prog)  ws_redact_prog ;;
  _logs-script)  ws_logs_script "$@" ;;   # internal: path lines follow [roots] (roots: tests only)
  -h|--help|help) usage ;;
  *) die "unknown subcommand '$sub' (see: water-spider --help)" ;;
esac
