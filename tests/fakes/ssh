#!/usr/bin/env bash
set -euo pipefail

# Probe mode (ps/gpu): the script arrives on stdin for `bash -s`. Never run it;
# log argv + the script and answer with a fixture.
if [[ " $* " == *" bash -s"* ]]; then
  if [ -n "${FAKE_SSH_LOG:-}" ]; then
    { printf 'ARGV: %s\n' "$*"; echo '--- stdin script ---'; cat; echo '--- end ---'; } >>"$FAKE_SSH_LOG"
  else
    cat >/dev/null
  fi
  [ "${FAKE_SSH_PROBE_FAIL:-0}" = 1 ] && { echo "Permission denied (publickey) token=hf_ABCDEFGH12345678" >&2; exit 255; }
  if [ -n "${FAKE_SSH_SEQ:-}" ]; then
    # FAKE_SSH_SEQ="a:b" answers the 1st call with a, then b (counter file FAKE_SSH_COUNTER)
    c="$(cat "$FAKE_SSH_COUNTER" 2>/dev/null || echo 0)"; echo $((c + 1)) > "$FAKE_SSH_COUNTER"
    IFS=: read -ra seq <<<"$FAKE_SSH_SEQ"; idx=$(( c < ${#seq[@]} ? c : ${#seq[@]} - 1 ))
    cat "${seq[$idx]}"; exit 0
  fi
  cat "${FAKE_SSH_PROBE_FILE:?FAKE_SSH_PROBE_FILE not set}"
  exit 0
fi

if [ "${FAKE_SSH_REQUIRE_AGENT:-0}" = "1" ] && [[ "$*" == *"llama-server"* ]]; then
  [[ "$*" == *"--host 127.0.0.1"* ]]
  [[ "$*" == *"--jinja --flash-attn auto --alias speedy"* ]]
fi
if [ "${FAKE_SSH_AGENT_FAIL:-0}" = "1" ] && [[ "$*" == *"llama-server"* ]]; then
  exit 1
fi

case " $* " in
  *"zorro-image.json"*) printf '{"base":"test-image"}\n' ;;
  *"ZORRO_MODELS_DIR"*) printf '["test.gguf"]\n' ;;
  *) printf 'FAKE_SSH_OK\n' ;;
esac
